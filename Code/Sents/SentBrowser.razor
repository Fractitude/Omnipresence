@using Sandbox.UI
@inherits PanelComponent
@namespace Sandbox

<root class="menu-root @( IsOpen ? "open" : "" )">
	@if ( IsOpen )
	{
		<MenuWindow Title="Workshop Entities" Width=@width Height=@height Resizable=@( true ) OnResize=@Resize OnClose=@Close
		            Notice=@( Sents.CanSpawn ? null : "Only the host can spawn sents on this server." )
		            Hint="Entities made by the community. Some bring their own code, which runs in the game.">
			<ChildContent>
				<div class="search-bar">
					<TextEntry class="search" Placeholder="Search" Value:bind=@SentCatalog.Filter/>
					@foreach ( var mode in SentCatalog.Modes )
					{
						var m = mode;
						<div class="menu-button @( m == SentCatalog.Sort ? "active" : "" )" @onclick=@( () => SentCatalog.SetSort( m ) )>@m</div>
					}
				</div>
				<div class="sents-body">
					<div class="categories">
						@foreach ( var category in SentCatalog.Categories )
						{
							var c = category;
							<div @key=@c.Name class="category @( c.Tag == SentCatalog.Tag ? "active" : "" )" @onclick=@( () => SentCatalog.SetCategory( c ) )>
								<i>@c.Icon</i>
								<div class="label">@c.Name</div>
							</div>
						}
					</div>
					<div class="menu-list">
						@if ( SentCatalog.Entries.Count == 0 )
						{
							<div class="menu-empty">@( SentCatalog.Loading ? "Loading..." : "No sents found." )</div>
						}
						<div class="tiles">
							@foreach ( var entry in SentCatalog.Entries )
							{
								var e = entry;
								<div @key=@e.Ident class="tile @( SentLocal.IsIntegrated( e.Ident ) ? "integrated" : "" )" @onclick=@( () => Pick( e ) ) @onrightclick=@( () => OpenMenu( e ) )>
									<div class="thumb" style="background-image: url( @e.Thumb )"></div>
									<div class="title">@e.Title</div>
									<div class="org">@e.Org</div>
									@if ( SentLocal.IsIntegrated( e.Ident ) )
									{
										<i class="badge" title="Integrated into the project">check_circle</i>
									}
								</div>
							}
						</div>
						@if ( SentCatalog.Entries.Count > 0 && SentCatalog.Loading )
						{
							<div class="menu-empty">Loading...</div>
						}
					</div>
				</div>
			</ChildContent>
		</MenuWindow>
	}
</root>

@code
{
	const string MenuName = "sents";

	/// <summary>
	/// How close to the end of the list, in pixels, the next page starts loading.
	/// </summary>
	const float LoadAhead = 300f;

	/// <summary>
	/// Whether the panel is open on this computer.
	/// </summary>
	public static bool IsOpen { get; private set; }

	/// <summary>
	/// The window's size when it is first opened: four columns of tiles, and tall enough to show a few rows.
	/// </summary>
	static readonly Vector2 DefaultSize = new( 890, 680 );

	// Static: the panel's mouse events and this component's updates are not always on the same instance. The size is
	// kept for the session, so the window comes back as it was left.
	static int width = (int)DefaultSize.x;
	static int height = (int)DefaultSize.y;
	static Panel listPanel;
	static int searchesSeen;

	/// <summary>
	/// Open the browser. Does nothing with another menu open.
	/// </summary>
	[ConCmd( "sents" )]
	public static void Open()
	{
		if ( IsOpen || GameMenus.IsAnyOpen || NaviInputCapture.Current is not null )
			return;

		IsOpen = true;
		GameMenus.SetOpen( MenuName, true );
		_ = SentCatalog.Refresh();
	}

	static void Close()
	{
		if ( !IsOpen )
			return;

		IsOpen = false;
		ContextMenu.HideFor( MenuName );
		GameMenus.SetOpen( MenuName, false );
		MenuControls.Free( true );
		Mouse.Visibility = MouseVisibility.Hidden;
	}

	static void Resize( Vector2 size )
	{
		width = (int)size.x;
		height = (int)size.y;
	}

	static void Pick( SentCatalog.Entry entry )
	{
		if ( !Sents.CanSpawn )
			return;

		Sents.Spawn( entry.Ident );
		Close();
	}

	// Right-click on a tile: the ident to paste somewhere, the package's page, or making the sent part of the project.
	static void OpenMenu( SentCatalog.Entry entry )
	{
		var entries = new List<ContextEntry>
		{
			new( "copy", "Copy ident", "content_copy", true, () => Clipboard.SetText( entry.Ident ) ),
			new( "page", "Open package page", "open_in_new", true, () => Game.Overlay.ShowPackageModal( entry.Ident ) ),
		};

		// Integrating writes code and assets into the project, which only the editor can do.
		if ( Application.IsEditor )
		{
			if ( SentLocal.IsIntegrated( entry.Ident ) )
			{
				entries.Add( new ContextEntry( "integrated", "Integrated into project", "check_circle", false, () => { } ) );
				entries.Add( new ContextEntry( "update", "Update imported code", "sync", true, () => Update( entry ) ) );
				entries.Add( new ContextEntry( "remove", "Remove from project", "delete", true, () => ConfirmRemove( entry ) ) );
			}
			else
				entries.Add( new ContextEntry( "integrate", "Integrate into project", "download", true, () => Integrate( entry ) ) );
		}

		ContextMenu.Show( MenuName, entry.Title, entries.ToArray() );
	}

	// Deleting files is not undone by the editor, so the menu asks once more.
	static void ConfirmRemove( SentCatalog.Entry entry )
	{
		ContextMenu.Show( MenuName, $"Remove {entry.Title}?", new[]
		{
			new ContextEntry( "yes", "Delete its files (keeps code other sents use)", "delete_forever", true, () => Remove( entry ) ),
			new ContextEntry( "no", "Cancel", "close", true, () => { } ),
		} );
	}

	static void Update( SentCatalog.Entry entry )
	{
		Log.Info( $"sents: updating the imported code of {entry.Ident}; the result is in the console." );
		ConsoleSystem.Run( $"sent_import {entry.Ident} update" );
	}

	static void Remove( SentCatalog.Entry entry )
	{
		Log.Info( $"sents: removing {entry.Ident} from the project; the result is in the console." );
		ConsoleSystem.Run( $"sent_remove {entry.Ident}" );
	}

	static void Integrate( SentCatalog.Entry entry )
	{
		Log.Info( $"sents: integrating {entry.Ident} into the project; the result is in the console." );
		ConsoleSystem.Run( $"sent_integrate {entry.Ident}" );
	}

	/// <summary>
	/// Scrolled near the bottom: time for the next page.
	/// </summary>
	static bool NearEnd()
	{
		if ( !listPanel.IsValid() )
			return false;

		// ScrollSize is the height of everything in the list; zero is a list that has not been laid out yet.
		var content = listPanel.ScrollSize.y;
		return content > 0 && listPanel.ScrollOffset.y + listPanel.Box.Rect.Height >= content - LoadAhead;
	}

	protected override void OnUpdate()
	{
		if ( !IsOpen )
			return;

		// Escape closes the right-click menu first.
		if ( ContextMenu.IsOpen && Input.EscapePressed )
		{
			Input.EscapePressed = false;
			ContextMenu.Hide();
			return;
		}

		if ( Input.EscapePressed || NaviInputCapture.Current is not null )
		{
			Input.EscapePressed = false;
			Close();
			return;
		}

		Mouse.Visibility = MouseVisibility.Visible;
		MenuControls.Free( false );

		// The scrolling list: found each time it is gone, as the window rebuilds its panels.
		if ( !listPanel.IsValid() )
			listPanel = Panel?.Descendants.FirstOrDefault( x => x.HasClass( "menu-list" ) && x.Parent.HasClass( "sents-body" ) );

		// A new search starts at the top.
		if ( searchesSeen != SentCatalog.Searches )
		{
			searchesSeen = SentCatalog.Searches;

			if ( listPanel.IsValid() )
				listPanel.ScrollTo( Vector2.Zero );
		}

		if ( SentCatalog.HasMore && NearEnd() )
			_ = SentCatalog.LoadMore();
	}

	protected override void OnDisabled() => Close();

	protected override int BuildHash() => System.HashCode.Combine( IsOpen, SentCatalog.Version, SentCatalog.Sort, SentCatalog.Tag, width, height );
}
