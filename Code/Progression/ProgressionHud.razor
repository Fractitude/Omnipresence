@using Sandbox.UI
@inherits PanelComponent
@namespace Sandbox

<root class="@( NaviInputCapture.Current is not null ? "seated" : "" )">
	<div class="clock">@WorldClock.TimeOfDay <span class="date">@WorldClock.Day</span></div>
	@if ( PlayerProgress.Local is { Loaded: true } progress )
	{
		<div class="level">Lv @progress.Level</div>
		<div class="bar">
			<div class="fill" style="width: @( ProgressCurve.Fraction( progress.Xp ) * 100f )%"></div>
		</div>
		<div class="hack-level">Hacking Lv @progress.HackLevel</div>
		<div class="bar hack">
			<div class="fill" style="width: @( HackingCurve.Fraction( progress.HackXp ) * 100f )%"></div>
		</div>
		<div class="money">$@progress.Money.ToString( "N0" )</div>
		<div class="credits">@progress.Credits.ToString( "N0" ) credits</div>
	}
</root>

@code
{
	protected override int BuildHash()
	{
		var progress = PlayerProgress.Local;
		var clock = (WorldClock.TimeOfDay, WorldClock.Day, NaviInputCapture.Current is not null);

		return progress is { Loaded: true }
			? System.HashCode.Combine( progress.Xp, progress.HackXp, progress.Money, progress.Credits, clock )
			: System.HashCode.Combine( clock );
	}
}
