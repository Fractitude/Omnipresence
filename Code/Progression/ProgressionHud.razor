@using Sandbox.UI
@inherits PanelComponent
@namespace Sandbox

<root>
	<div class="clock">@WorldClock.TimeOfDay <span class="date">@WorldClock.Date</span></div>
	@if ( PlayerProgress.Local is { Loaded: true } progress )
	{
		<div class="level">Lv @progress.Level</div>
		<div class="bar">
			<div class="fill" style="width: @( ProgressCurve.Fraction( progress.Xp ) * 100f )%"></div>
		</div>
		<div class="money">$@progress.Money.ToString( "N0" )</div>
		<div class="credits">@progress.Credits.ToString( "N0" ) cr</div>
	}
</root>

@code
{
	protected override int BuildHash()
	{
		var progress = PlayerProgress.Local;
		var clock = WorldClock.TimeOfDay;

		return progress is { Loaded: true }
			? System.HashCode.Combine( progress.Xp, progress.Money, progress.Credits, clock )
			: System.HashCode.Combine( clock );
	}
}
