@using Sandbox.Movement
@using Sandbox.UI
@inherits PanelComponent
@namespace Sandbox

<root class="menu-root @( IsOpen ? "open" : "" )">
	@if ( IsOpen )
	{
		var text = WelcomeContent.Data;
		var news = text.Since( releaseSeenAtOpen ).ToList();
		var returning = seenAtOpen > 0;
		// A player who is up to date, or new, still sees the latest release.
		var shownNews = news.Count > 0 && returning;
		var shown = shownNews ? news : text.Changelog.Take( 1 ).ToList();

		<MenuWindow Title=@text.Title Width=@( 640 ) OnClose=@Close ShowClose=@( false )>
			<ChildContent>
				<div class="menu-list welcome">
					<div class="section">
						<div class="menu-heading">@WelcomeHeading</div>
						@* A line break in the text is a line break on the screen; an empty line is a gap. *@
						@foreach ( var line in text.Intro.Replace( "\r", "" ).Split( '\n' ) )
						{
							<div class="text line">@line</div>
						}
					</div>

					<div class="section">
						<div class="menu-heading">@text.RulesHeading</div>
						@foreach ( var rule in text.Rules )
						{
							<div class="rule">
								<i class="bullet">fiber_manual_record</i>
								<div class="rule-text">@rule</div>
							</div>
						}
					</div>

					<div class="section">
						<div class="menu-heading">@( shownNews ? NewHeading : LatestHeading )</div>
						@foreach ( var entry in shown )
						{
							<div class="release">
								<div class="release-title">@( $"Version {entry.Version}: {entry.Title}" )</div>
								@foreach ( var change in entry.Changes )
								{
									<div class="change">@change</div>
								}
							</div>
						}
					</div>
				</div>
				<div class="footer">
					@if ( Networking.IsHost )
					{
						<div class="menu-button" @onclick=@Edit>Edit</div>
					}
					else
					{
						<div></div>
					}
					<div class="menu-button" @onclick=@Close>@text.PlayButton</div>
				</div>
			</ChildContent>
		</MenuWindow>
	}
</root>

@code
{
	// The headings are the game's, not the host's: they are not in the editor.
	const string WelcomeHeading = "Welcome";
	const string NewHeading = "What's new since you last played";
	const string LatestHeading = "Latest changes";

	/// <summary>
	/// Whether the screen is open on this computer.
	/// </summary>
	public static bool IsOpen { get; private set; }

	// Static: the panel's mouse events and this component's updates are not always on the same instance.
	// The version the player had seen when the screen opened, so the list does not change when it is saved on close.
	static int seenAtOpen;
	static int releaseSeenAtOpen;

	// Whether the join screen was already shown to this player in this session.
	static bool shownOnJoin;

	const string SeenFile = "welcome_seen.txt";

	/// <summary>
	/// What this player last saw, kept in this computer's game data: the screen's version, and the newest changelog
	/// release it listed. 0 for both if none (an older file holds only the version, which was both).
	/// </summary>
	static (int Version, int Release) LoadSeen()
	{
		try
		{
			if ( FileSystem.Data.FileExists( SeenFile ) )
			{
				var parts = FileSystem.Data.ReadAllText( SeenFile )
					.Split( ' ', System.StringSplitOptions.RemoveEmptyEntries );

				if ( parts.Length > 0 && int.TryParse( parts[0], out var version ) )
					return (version, parts.Length > 1 && int.TryParse( parts[1], out var release ) ? release : version);
			}
		}
		catch ( System.Exception e )
		{
			Log.Warning( $"Could not read {SeenFile}: {e.Message}" );
		}

		return (0, 0);
	}

	static void SaveSeen( int version, int release )
	{
		try
		{
			FileSystem.Data.WriteAllText( SeenFile, $"{version} {release}" );
		}
		catch ( System.Exception e )
		{
			Log.Warning( $"Could not write {SeenFile}: {e.Message}" );
		}
	}

	/// <summary>
	/// Whether the player can be shown a window now: in the world, alive, not steering a seat, no other menu or Navi
	/// computer using the keyboard.
	/// </summary>
	static bool CanShow()
	{
		var controller = Players.LocalController;

		return controller.IsValid() && Players.Local<PlayerHealth>() is { Health: > 0 }
		       && controller.GetComponentInParent<ISitTarget>( false ) is null
		       && !GameMenus.IsAnyOpen && NaviInputCapture.Current is null;
	}

	/// <summary>
	/// Open the screen. Does nothing with another menu open.
	/// </summary>
	public static void Open()
	{
		if ( IsOpen || GameMenus.IsAnyOpen || NaviInputCapture.Current is not null )
			return;

		(seenAtOpen, releaseSeenAtOpen) = LoadSeen();
		IsOpen = true;
		GameMenus.SetOpen( "welcome", true );
	}

	static void Close()
	{
		if ( !IsOpen )
			return;

		IsOpen = false;
		GameMenus.SetOpen( "welcome", false );
		SaveSeen( WelcomeContent.Data.Version, WelcomeContent.Data.LatestRelease() );
		MenuControls.Free( true );
		Mouse.Visibility = MouseVisibility.Hidden;
	}

	/// <summary>
	/// The host's Edit button: put the screen away and open the editor.
	/// </summary>
	static void Edit()
	{
		Close();
		WelcomeScreenEditor.Open();
	}

	/// <summary>
	/// Open the welcome screen again.
	/// </summary>
	[ConCmd( "welcome" )]
	public static void OpenCommand() => Open();

	protected override void OnUpdate()
	{
		if ( !IsOpen )
		{
			// Once per session, as soon as the player is standing in the world, and only if they have not seen this
			// version of the screen: a new player has seen none.
			// Wait for the host's text: until it arrives the screen would show the default.
			if ( !shownOnJoin && WelcomeContent.IsReady && CanShow() )
			{
				shownOnJoin = true;

				if ( LoadSeen().Version < WelcomeContent.Data.Version )
					Open();
			}

			return;
		}

		if ( Input.EscapePressed || NaviInputCapture.Current is not null || !Players.LocalController.IsValid() )
		{
			Input.EscapePressed = false;
			Close();
			return;
		}

		Mouse.Visibility = MouseVisibility.Visible;
		MenuControls.Free( false );
	}

	protected override void OnDisabled() => Close();

	protected override int BuildHash() => System.HashCode.Combine( IsOpen, seenAtOpen, releaseSeenAtOpen, WelcomeContent.Revision );
}
