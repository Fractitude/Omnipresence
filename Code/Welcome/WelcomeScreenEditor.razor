@using Sandbox.UI
@inherits PanelComponent
@namespace Sandbox

<root class="menu-root @( IsOpen ? "open" : "" )">
	@if ( IsOpen && draft is { } d )
	{
		<MenuWindow Title="Edit the welcome screen" Width=@( 760 ) OnClose=@Close ShowClose=@( false ) Notice=@notice>
			<ChildContent>
				<div class="menu-list editor">
					<div class="section">
						<div class="menu-heading">Text</div>
						<div class="caption">Window title</div>
						<TextEntry class="input" Multiline=@( true ) Value=@d.Title MaxLength=@( 120 )
						           OnTextEdited=@( ( string t ) => { d.Title = t; } )/>
						<div class="caption">About the server</div>
						<TextEntry class="input tall" Multiline=@( true ) Value=@d.Intro MaxLength=@( 2000 )
						           OnTextEdited=@( ( string t ) => { d.Intro = t; } )/>
						<div class="caption">Play button</div>
						<TextEntry class="input" Multiline=@( true ) Value=@d.PlayButton MaxLength=@( 40 )
						           OnTextEdited=@( ( string t ) => { d.PlayButton = t; } )/>
					</div>

					<div class="section">
						<div class="menu-heading">Rules</div>
						<div class="caption">Heading</div>
						<TextEntry class="input" Multiline=@( true ) Value=@d.RulesHeading MaxLength=@( 120 )
						           OnTextEdited=@( ( string t ) => { d.RulesHeading = t; } )/>
						@foreach ( var rule in rules )
						{
							var line = rule;
							<div @key=@line.Key class="line-row">
								<TextEntry class="input" Multiline=@( true ) Value=@line.Text MaxLength=@( 500 )
								           OnTextEdited=@( ( string t ) => { line.Text = t; } )/>
								<div class="menu-button small" @onclick=@( () => Remove( rules, line ) )>Remove</div>
							</div>
						}
						<div class="menu-button add" @onclick=@( () => rules.Add( new() ) )>Add a rule</div>
					</div>

					<div class="section">
						<div class="heading-row">
							<div class="menu-heading">Changelog</div>
							<div class="menu-button" @onclick=@AddEntry>Add a release</div>
						</div>

						@foreach ( var release in releases )
						{
							var entry = release;
							<div @key=@entry.Key class="entry">
								<div class="line-row">
									<div class="caption fixed">@( $"Version {entry.Version}" )</div>
									<TextEntry class="input" Multiline=@( true ) Value=@entry.Title MaxLength=@( 120 )
									           Placeholder="Title"
									           OnTextEdited=@( ( string t ) => { entry.Title = t; } )/>
									<div class="menu-button small" @onclick=@( () => Remove( releases, entry ) )>Remove</div>
								</div>
								@foreach ( var change in entry.Changes )
								{
									var line = change;
									<div @key=@line.Key class="line-row">
										<TextEntry class="input" Multiline=@( true ) Value=@line.Text MaxLength=@( 500 )
										           OnTextEdited=@( ( string t ) => { line.Text = t; } )/>
										<div class="menu-button small"
										     @onclick=@( () => Remove( entry.Changes, line ) )>Remove</div>
									</div>
								}
								<div class="menu-button add" @onclick=@( () => entry.Changes.Add( new() ) )>Add a change</div>
							</div>
						}
					</div>
				</div>
				<div class="footer">
					<div class="menu-button" @onclick=@ResetText>Reset to default</div>
					<div class="actions">
						<div class="menu-button" @onclick=@Close>Cancel</div>
						<div class="menu-button save" @onclick=@Save>Save</div>
					</div>
				</div>
			</ChildContent>
		</MenuWindow>
	}
</root>

@code
{
	/// <summary>
	/// Whether the editor is open on this computer.
	/// </summary>
	public static bool IsOpen { get; private set; }

	/// <summary>
	/// One line of text in a list. Each has a key of its own, so removing one leaves the panels of the others as they
	/// are: nothing is drawn again, and the list keeps its scroll.
	/// </summary>
	sealed class Line
	{
		public string Key { get; } = $"line{++nextKey}";
		public string Text { get; set; } = "";
	}

	/// <summary>
	/// A release being edited.
	/// </summary>
	sealed class Release
	{
		public string Key { get; } = $"release{++nextKey}";
		public int Version { get; set; }
		public string Title { get; set; } = "";
		public List<Line> Changes { get; set; } = new();
	}

	// Static: the panel's events and this component's updates are not always on the same instance.
	// The copy being edited: nothing changes for the players until Save. Its lists are kept apart, as rows.
	static WelcomeData draft;
	static List<Line> rules = new();
	static List<Release> releases = new();
	static string notice;
	static int nextKey;

	// Goes up when the text is started again (Open, Reset), which the counts alone would not show.
	static int generation;

	/// <summary>
	/// Whether this computer can edit the text: only the host can.
	/// </summary>
	public static bool CanEdit => Networking.IsHost;

	/// <summary>
	/// Open the editor with the current text. Does nothing for a client, or with another menu open.
	/// </summary>
	public static void Open()
	{
		if ( IsOpen || !CanEdit || !WelcomeContent.IsReady || GameMenus.IsAnyOpen
		     || NaviInputCapture.Current is not null )
			return;

		Begin( WelcomeContent.Data.Copy() );
		notice = null;
		IsOpen = true;
		GameMenus.SetOpen( "welcomeeditor", true );
	}

	static void Close()
	{
		if ( !IsOpen )
			return;

		IsOpen = false;
		draft = null;
		GameMenus.SetOpen( "welcomeeditor", false );
		MenuControls.Free( true );
		Mouse.Visibility = MouseVisibility.Hidden;
	}

	/// <summary>
	/// Open the welcome screen editor (host only).
	/// </summary>
	[ConCmd( "welcome_edit" )]
	public static void OpenCommand()
	{
		if ( !CanEdit )
		{
			Log.Info( "Only the host can edit the welcome screen." );
			return;
		}

		Open();
	}

	/// <summary>
	/// Start editing some text: its lists become rows.
	/// </summary>
	static void Begin( WelcomeData data )
	{
		generation++;
		draft = data;
		rules = data.Rules.Select( x => new Line { Text = x } ).ToList();

		releases = data.Changelog
			.Select( x => new Release
			{
				Version = x.Version,
				Title = x.Title,
				Changes = x.Changes.Select( y => new Line { Text = y } ).ToList(),
			} )
			.ToList();
	}

	/// <summary>
	/// The edited text as data again.
	/// </summary>
	static WelcomeData Collect()
	{
		draft.Rules = rules.Select( x => x.Text ).ToList();

		draft.Changelog = releases
			.Select( x => new ChangelogEntry
			{
				Version = x.Version,
				Title = x.Title,
				Changes = x.Changes.Select( y => y.Text ).ToList(),
			} )
			.ToList();

		return draft;
	}

	static void Save()
	{
		if ( draft is null )
			return;

		notice = null;
		var data = Collect();

		// Every save is a new version: players who saw the last one are shown the screen again.
		data.Version = WelcomeContent.Data.Version + 1;

		if ( WelcomeContent.Save( data, out var error ) )
			Close();
		else
			notice = error ?? "Could not save. See the console.";
	}

	/// <summary>
	/// Put the text back to the default. The changelog is not text of the default: its releases are the host's own work,
	/// so they are kept as they are.
	/// </summary>
	static void ResetText()
	{
		var kept = releases;
		Begin( new() );
		releases = kept;
	}

	/// <summary>
	/// Add a release at the top. Its number is the highest there is plus one, so a number freed by removing the newest
	/// releases is used again, and one freed from the middle is not.
	/// </summary>
	static void AddEntry()
	{
		var next = releases.Count == 0 ? 1 : releases.Max( x => x.Version ) + 1;
		releases.Insert( 0, new() { Version = next, Changes = new() { new() } } );
	}

	static void Remove<T>( List<T> list, T item ) => list.Remove( item );

	protected override void OnUpdate()
	{
		if ( !IsOpen )
			return;

		if ( Input.EscapePressed || NaviInputCapture.Current is not null || !Players.LocalController.IsValid()
		     || !CanEdit )
		{
			Input.EscapePressed = false;
			Close();
			return;
		}

		Mouse.Visibility = MouseVisibility.Visible;
		MenuControls.Free( false );
	}

	protected override void OnDisabled() => Close();

	protected override int BuildHash() => System.HashCode.Combine(
		IsOpen, generation, notice, rules.Count, releases.Count, releases.Sum( x => x.Changes.Count ) );
}
