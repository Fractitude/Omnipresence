@using Sandbox.UI
@inherits PanelComponent
@namespace Sandbox

<root class="menu-root @( IsOpen ? "open" : "" )">
	@if ( IsOpen && !rebuilding && draft is { } d )
	{
		<MenuWindow Title="Edit the welcome screen" Width=@( 760 ) OnClose=@Close ShowClose=@( false ) Notice=@notice>
			<ChildContent>
				<div @ref=List class="menu-list editor">
					<div class="section">
						<div class="menu-heading">Text</div>
						<div class="caption">Window title</div>
						<TextEntry class="input" Multiline=@( true ) Value=@d.Title MaxLength=@( 120 ) OnTextEdited=@( ( string t ) => { d.Title = t; } )/>
						<div class="caption">About the server</div>
						<TextEntry class="input tall" Multiline=@( true ) Value=@d.Intro MaxLength=@( 2000 )
						           OnTextEdited=@( ( string t ) => { d.Intro = t; } )/>
						<div class="caption">Play button</div>
						<TextEntry class="input" Multiline=@( true ) Value=@d.PlayButton MaxLength=@( 40 )
						           OnTextEdited=@( ( string t ) => { d.PlayButton = t; } )/>
					</div>

					<div class="section">
						<div class="menu-heading">Rules</div>
						<div class="caption">Heading</div>
						<TextEntry class="input" Multiline=@( true ) Value=@d.RulesHeading MaxLength=@( 120 )
						           OnTextEdited=@( ( string t ) => { d.RulesHeading = t; } )/>
						@for ( var i = 0; i < d.Rules.Count; i++ )
						{
							var index = i;
							<div class="line-row">
								<TextEntry class="input" Multiline=@( true ) Value=@d.Rules[index] MaxLength=@( 500 )
								           OnTextEdited=@( ( string t ) => { d.Rules[index] = t; } )/>
								<div class="menu-button small" @onclick=@( () => Remove( d.Rules, index ) )>Remove</div>
							</div>
						}
						<div class="menu-button add" @onclick=@( () => d.Rules.Add( "" ) )>Add a rule</div>
					</div>

					<div class="section">
						<div class="heading-row">
							<div class="menu-heading">Changelog</div>
							<div class="menu-button" @onclick=@AddEntry>Add a release</div>
						</div>

						@for ( var i = 0; i < d.Changelog.Count; i++ )
						{
							var entry = d.Changelog[i];
							var at = i;
							<div class="entry">
								<div class="line-row">
									<div class="caption fixed">@( $"Version {entry.Version}" )</div>
									<TextEntry class="input" Multiline=@( true ) Value=@entry.Title MaxLength=@( 120 ) Placeholder="Title"
									           OnTextEdited=@( ( string t ) => { entry.Title = t; } )/>
									<div class="menu-button small" @onclick=@( () => Remove( d.Changelog, at ) )>Remove</div>
								</div>
								@for ( var c = 0; c < entry.Changes.Count; c++ )
								{
									var change = c;
									<div class="line-row">
										<TextEntry class="input" Multiline=@( true ) Value=@entry.Changes[change] MaxLength=@( 500 )
										           OnTextEdited=@( ( string t ) => { entry.Changes[change] = t; } )/>
										<div class="menu-button small"
										     @onclick=@( () => Remove( entry.Changes, change ) )>Remove</div>
									</div>
								}
								<div class="menu-button add" @onclick=@( () => entry.Changes.Add( "" ) )>Add a change</div>
							</div>
						}
					</div>
				</div>
				<div class="footer">
					<div class="menu-button" @onclick=@ResetText>Reset to default</div>
					<div class="actions">
						<div class="menu-button" @onclick=@Close>Cancel</div>
						<div class="menu-button save" @onclick=@Save>Save</div>
					</div>
				</div>
			</ChildContent>
		</MenuWindow>
	}
</root>

@code
{
	/// <summary>
	/// Whether the editor is open on this computer.
	/// </summary>
	public static bool IsOpen { get; private set; }

	// Static: the panel's events and this component's updates are not always on the same instance.
	// The copy being edited: nothing changes for the players until Save.
	static WelcomeData draft;
	static string notice;

	// A removed line makes the panels below it hold the wrong text, so the list is drawn again from scratch. The list
	// is scrolled back to where it was once it is there again.
	static bool rebuilding;
	static Vector2 scrolled;
	static int restoreFrames;
	static Panel List { get; set; }

	/// <summary>
	/// Whether this computer can edit the text: only the host can.
	/// </summary>
	public static bool CanEdit => Networking.IsHost;

	/// <summary>
	/// Open the editor with the current text. Does nothing for a client, or with another menu open.
	/// </summary>
	public static void Open()
	{
		if ( IsOpen || !CanEdit || !WelcomeContent.IsReady || GameMenus.IsAnyOpen
		     || NaviInputCapture.Current is not null )
			return;

		draft = WelcomeContent.Data.Copy();
		notice = null;
		restoreFrames = 0;
		rebuilding = false;
		IsOpen = true;
		GameMenus.SetOpen( "welcomeeditor", true );
	}

	static void Close()
	{
		if ( !IsOpen )
			return;

		IsOpen = false;
		draft = null;
		GameMenus.SetOpen( "welcomeeditor", false );
		MenuControls.Free( true );
		Mouse.Visibility = MouseVisibility.Hidden;
	}

	/// <summary>
	/// Open the welcome screen editor (host only).
	/// </summary>
	[ConCmd( "welcome_edit" )]
	public static void OpenCommand()
	{
		if ( !CanEdit )
		{
			Log.Info( "Only the host can edit the welcome screen." );
			return;
		}

		Open();
	}

	static void Save()
	{
		if ( draft is null )
			return;

		// Every save is a new version: players who saw the last one are shown the screen again.
		draft.Version = WelcomeContent.Data.Version + 1;

		if ( WelcomeContent.Save( draft ) )
			Close();
		else
			notice = "Could not save. See the console.";
	}

	static void ResetText()
	{
		draft = new();
		Rebuild();
	}

	static void AddEntry() =>
		draft.Changelog.Insert(
			0, new() { Version = draft.NextRelease(), Title = "", Changes = new() { "" } } );

	static void Remove<T>( List<T> list, int index )
	{
		if ( index < 0 || index >= list.Count )
			return;

		list.RemoveAt( index );
		Rebuild();
	}

	static void Rebuild()
	{
		scrolled = List is { IsValid: true } ? List.ScrollOffset : default;
		rebuilding = true;
	}

	protected override void OnUpdate()
	{
		if ( !IsOpen )
			return;

		if ( Input.EscapePressed || NaviInputCapture.Current is not null || !Players.LocalController.IsValid()
		     || !CanEdit )
		{
			Input.EscapePressed = false;
			Close();
			return;
		}

		// One frame with nothing drawn, so every row is made again from the list.
		if ( rebuilding && wasRebuilding )
		{
			rebuilding = false;
			restoreFrames = 3;
		}
		else if ( restoreFrames > 0 && List is { IsValid: true } )
		{
			List.ScrollOffset = scrolled;
			restoreFrames--;
		}

		wasRebuilding = rebuilding;

		Mouse.Visibility = MouseVisibility.Visible;
		MenuControls.Free( false );
	}

	bool wasRebuilding;

	protected override void OnDisabled() => Close();

	protected override int BuildHash() => System.HashCode.Combine(
		IsOpen, rebuilding, notice, draft?.Rules.Count, draft?.Changelog.Count,
		draft?.Changelog.Sum( x => x.Changes.Count ) );
}
