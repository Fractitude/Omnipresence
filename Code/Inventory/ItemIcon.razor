@using Sandbox.UI
@inherits Panel
@namespace Sandbox

<root>
	@if ( ItemIcons.SceneFor( PrefabPath, ModelPath ) is { } scene )
	{
		@* The scene is given as an attribute, so the panel never ticks the game scene (see AGENTS.md, "UI pitfalls"). *@
		<ScenePanel class="scene" RenderScene=@scene/>
	}
	else
	{
		<i style="@( string.IsNullOrEmpty( Color ) ? "" : $"color: {Color}" )">@( string.IsNullOrEmpty( Icon ) ? "inventory_2" : Icon )</i>
	}
</root>

@code
{
	/// <summary>
	/// The resource path of the prefab drawn. Empty draws only the model.
	/// </summary>
	public string PrefabPath { get; set; }

	/// <summary>
	/// The resource path of the model drawn, when there is no prefab (or it doesn't load).
	/// </summary>
	public string ModelPath { get; set; }

	/// <summary>
	/// The glyph drawn when there is no prefab or model. Empty draws a plain box.
	/// </summary>
	public string Icon { get; set; }

	/// <summary>
	/// The glyph's colour, like "#8be28b", or empty for the default.
	/// </summary>
	public string Color { get; set; }

	protected override int BuildHash() => System.HashCode.Combine( PrefabPath, ModelPath, Icon, Color );
}
