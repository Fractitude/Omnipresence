@using Sandbox.UI
@inherits Panel
@namespace Sandbox

<root>
	<div class="heading">Inventory</div>
	<div class="hint">@StackDrag.Hint</div>
	@if ( Inventory is { } inventory )
	{
		<div @ref="Grid" class="grid" style="width: @( inventory.Columns * (SlotSize + Gap) - Gap )px">
			@for ( var i = 0; i < inventory.SlotCount; i++ )
			{
				var slot = i;
				var item = inventory.At( slot );
				<div class="slot @( item is null ? "empty" : "" ) @( Marks( slot ) )"
				     @onmousedown=@( ( PanelEvent e ) => BeginDrag( slot, e ) )
				     @onrightclick=@( () => OpenMenu( slot ) )
				     @onmouseover=@( () => Hovered = slot )
				     @onmouseout=@( () => { if ( Hovered == slot ) Hovered = -1; } )>
					@if ( item is not null )
					{
						<ItemIcon PrefabPath=@item.PrefabPath ModelPath=@item.ModelPath Icon=@ItemCatalog.IconFor( item ) Color=@ItemCatalog.ColorFor( item )/>
						@if ( item.IsBatch )
						{
							<div class="count">@( $"x{item.Count}" )</div>
						}
					}
				</div>
			}
		</div>
	}
</root>

@code
{
	const string MenuName = "character";
	const int SlotSize = 64;
	const int Gap = 6;

	// Static: the panel's mouse events and the menu's updates are not always on the same instance.
	static InventoryGrid current;
	static int dragFrom = -1;
	static int hovered = -1;

	/// <summary>
	/// The slot being dragged, or -1.
	/// </summary>
	public static int DragFrom => dragFrom;

	/// <summary>
	/// The slot the mouse is over, or -1.
	/// </summary>
	public static int Hovered
	{
		get => hovered;
		private set => hovered = value;
	}

	/// <summary>
	/// The item being dragged, or null.
	/// </summary>
	public static ItemData Dragged => dragFrom >= 0 ? PlayerInventory.Local?.At( dragFrom ) : null;

	/// <summary>
	/// The item under the mouse while nothing is dragged, or null.
	/// </summary>
	public static ItemData HoveredItem => dragFrom < 0 && hovered >= 0 ? PlayerInventory.Local?.At( hovered ) : null;

	/// <summary>
	/// A hash of what the grid shows, for the menu that draws the dragged icon and the details.
	/// </summary>
	public static int State => System.HashCode.Combine(
		PlayerInventory.Local?.Version, dragFrom, hovered, dragFrom >= 0 ? StackDrag.Held() : StackMode.None );

	/// <summary>
	/// The label beside the dragged icon while Shift or Ctrl is held ("Combine", "Split half", ...), or null.
	/// </summary>
	public static string DropLabel
	{
		get
		{
			var mode = StackDrag.Held();

			if ( Dragged is not { } dragged || mode == StackMode.None )
				return null;

			var to = SlotAt( Mouse.Position );
			var over = to >= 0 && to != dragFrom ? PlayerInventory.Local?.At( to ) : null;
			return StackDrag.Label( dragged, over, mode, to >= 0 && to != dragFrom );
		}
	}

	/// <summary>
	/// The style class of a slot: the one being dragged, or the one a held key's drop would work on.
	/// </summary>
	static string Marks( int slot )
	{
		var mode = StackDrag.Held();

		if ( dragFrom < 0 )
			return "";

		if ( slot == dragFrom )
			return "dragged";

		if ( mode == StackMode.None || SlotAt( Mouse.Position ) != slot )
			return "";

		return StackDrag.Works( Dragged, PlayerInventory.Local?.At( slot ), mode ) ? "target" : "";
	}

	PlayerInventory Inventory => PlayerInventory.Local;

	Panel Grid { get; set; }

	protected override void OnAfterTreeRender( bool firstTime )
	{
		current = this;
	}

	public override void OnDeleted()
	{
		if ( current == this )
			current = null;
	}

	static void BeginDrag( int slot, PanelEvent e )
	{
		// A right press is a right click (the slot's menu), not a drag. The button's name on the untyped event is not
		// reliable, so only one known to be the right one is turned away.
		var button = e?.Button ?? "";

		if ( button.Contains( "right", System.StringComparison.OrdinalIgnoreCase ) || button.Contains( "2" ) )
			return;

		if ( PlayerInventory.Local?.At( slot ) is not null )
			dragFrom = slot;
	}

	/// <summary>
	/// Forget the drag and the hover, and close the right-click menu, e.g. when the menu closes.
	/// </summary>
	public static void Cancel()
	{
		dragFrom = -1;
		hovered = -1;
		ContextMenu.HideFor( MenuName );
	}

	/// <summary>
	/// Right click on a slot: a small menu of what can be done with the stack there (<see cref="ItemMenus.ForBag"/>:
	/// drop it, as dragging it out of the window does). The host checks the drop again.
	/// </summary>
	static void OpenMenu( int slot )
	{
		dragFrom = -1;

		if ( PlayerInventory.Local?.At( slot ) is not { } item )
		{
			ContextMenu.HideFor( MenuName );
			return;
		}

		ContextMenu.Show( MenuName, item.Name, ItemMenus.Bind( ItemMenus.ForBag( item, null ), verb => verb switch
		{
			ItemMenus.Drop => () => PlayerInventory.Local?.Drop( slot ),
			_ => null,
		} ) );
	}

	/// <summary>
	/// The mouse button came up: drop the dragged item on the slot under the mouse, or on the floor when the mouse is
	/// outside the whole window. Dropped on the window but not on a slot, it stays where it was.
	/// </summary>
	public static void EndDrag( Vector2 mouse, Rect window, PanelEvent e = null )
	{
		var from = dragFrom;
		dragFrom = -1;

		if ( from < 0 || PlayerInventory.Local is not { } inventory )
			return;

		var to = SlotAt( mouse );
		var mode = StackDrag.Held( e );

		// With Shift or Ctrl held a drop combines or splits, or does nothing: it never swaps or throws the stack away.
		if ( mode != StackMode.None )
		{
			if ( to >= 0 && to != from && StackDrag.Worth( inventory.At( to ), mode ) )
				inventory.Stack( from, to, mode );

			return;
		}

		if ( to >= 0 )
			inventory.Move( from, to );
		else if ( !window.IsInside( mouse ) )
			inventory.Drop( from );
	}

	/// <summary>
	/// The slot under a screen position, or -1.
	/// </summary>
	static int SlotAt( Vector2 screenPosition )
	{
		if ( current?.Grid is not { } grid )
			return -1;

		var index = 0;

		foreach ( var child in grid.Children )
		{
			if ( child.Box.Rect.IsInside( screenPosition ) )
				return index;

			index++;
		}

		return -1;
	}

	protected override int BuildHash() => State;
}
