@using Sandbox.UI
@inherits PanelComponent
@namespace Sandbox

<root class="@( AbilityMenu.IsOpen ? "editing" : "" ) @( NaviInputCapture.Current is not null ? "seated" : "" )" @onmouseup=@EndDrag>
	@for ( var i = 0; i < AbilityLoadout.SlotCount; i++ )
	{
		var slot = i;
		var ability = AbilityLoadout.At( slot );
		var drop = AbilityMenu.IsOpen && AbilityLoadout.Dragging is not null;
		<div class="slot @( ability is null ? "empty" : ability.Kind.ToString().ToLowerInvariant() ) @( drop ? "target" : "" )"
		     @onmousedown=@( () => BeginDrag( slot ) )>
			<div class="key">@AbilityLoadout.KeyLabel( slot )</div>
			@if ( ability is not null )
			{
				<div class="icon"><i>@ability.Icon</i></div>
				<div class="cooldown" style="height: @( AbilityLoadout.CooldownFraction( ability ) * 100f )%"></div>
			}
		</div>
	}
</root>

@code
{
	static AbilityHotbar current;

	/// <summary>
	/// The slot under a screen position, or -1.
	/// </summary>
	public static int SlotAt( Vector2 screenPosition )
	{
		if ( current?.Panel is not { } root )
			return -1;

		var index = 0;

		foreach ( var child in root.Children )
		{
			if ( child.Box.Rect.IsInside( screenPosition ) )
				return index;

			index++;
		}

		return -1;
	}

	protected override void OnEnabled()
	{
		current = this;
	}

	protected override void OnUpdate()
	{
		if ( AbilityMenu.IsOpen || CharacterMenu.IsOpen || NaviInputCapture.Current is not null )
			return;

		for ( var i = 0; i < AbilityLoadout.SlotCount; i++ )
		{
			if ( Input.Pressed( AbilityLoadout.ActionName( i ) ) )
				AbilityLoadout.TryActivate( i );
		}
	}

	void BeginDrag( int slot )
	{
		if ( AbilityMenu.IsOpen )
			AbilityLoadout.BeginDrag( AbilityLoadout.At( slot ), slot );
	}

	void EndDrag()
	{
		AbilityLoadout.Drop( SlotAt( Mouse.Position ) );
	}

	protected override int BuildHash()
	{
		// Redraw every few frames while something cools down, so the sweep moves.
		var cooling = 0;

		for ( var i = 0; i < AbilityLoadout.SlotCount; i++ )
			cooling = cooling * 31 + (int)(AbilityLoadout.CooldownFraction( AbilityLoadout.At( i ) ) * 100f);

		var seated = NaviInputCapture.Current is not null;
		var dragging = AbilityLoadout.Dragging is not null;

		return System.HashCode.Combine( seated, AbilityMenu.IsOpen, AbilityLoadout.Version, dragging, cooling );
	}
}
