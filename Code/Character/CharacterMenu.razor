@using Sandbox.UI
@inherits PanelComponent
@namespace Sandbox

<root class="@( IsOpen ? "open" : "" )" @onmouseup=@( ( PanelEvent e ) => EndDrag( e ) )>
	@if ( IsOpen )
	{
		<div @ref="Window" class="window">
			<div class="character">
				<div class="title">Character</div>
				<div class="viewport">
					<AvatarPreview @ref="Preview"/>
					<div class="view-controls">
						<UIDropdown class="focus" Items=@FocusItems Value=@Focus ValueChanged=@SetFocus Tooltip="Where scrolling zooms in to"/>
						<UIButton Text="Reset" Icon="center_focus_strong" @onclick=@( () => Preview?.ResetView() )/>
					</div>
				</div>
				<div class="hint">Drag to turn your character, scroll to zoom.</div>
				<WalletStrip/>
			</div>
			<InventoryGrid class="inventory"/>
		</div>

		@if ( InventoryGrid.Dragged is { } dragged )
		{
			var position = Mouse.Position * Panel.ScaleFromScreen;
			<div class="ghost" style="left: @( position.x )px; top: @( position.y )px">
				<ItemIcon PrefabPath=@dragged.PrefabPath ModelPath=@dragged.ModelPath Icon=@ItemCatalog.IconFor( dragged ) Color=@ItemCatalog.ColorFor( dragged )/>
				@if ( InventoryGrid.DropLabel is { } label )
				{
					<div class="ghost-label">@label</div>
				}
			</div>
		}
		else if ( InventoryGrid.HoveredItem is { } hovered )
		{
			@* The full details of the item under the mouse. *@
			var position = Mouse.Position * Panel.ScaleFromScreen;
			<div class="details" style="left: @( position.x + 18 )px; top: @( position.y + 18 )px">
				<div class="name">@hovered.Name</div>
				@if ( hovered.IsBatch )
				{
					@foreach ( var line in ItemCatalog.DescribeLines( hovered ) )
					{
						<div class="description">@line</div>
					}
				}
				@if ( !string.IsNullOrEmpty( hovered.Description ) )
				{
					<div class="description">@hovered.Description</div>
				}
			</div>
		}
	}
</root>

@code
{
	/// <summary>
	/// Whether the menu is open on this computer. The crosshair reads it.
	/// </summary>
	public static bool IsOpen { get; private set; }

	// The same preview, zoom and focus menu as the player customizer's (Code/Customizer/AvatarPreview.cs).
	static readonly List<UIDropdown.Item> FocusItems = UIDropdown.ForEnum<PreviewFocus>();

	AvatarPreview Preview { get; set; }

	Panel Window { get; set; }

	PreviewFocus Focus { get; set; } = PreviewFocus.Head;

	/// <summary>
	/// Whether the preview has been dressed since the menu opened.
	/// </summary>
	bool dressed;

	/// <summary>
	/// Whether the scene only draws a preview (the character here or in the customizer, or an item icon). Game systems
	/// must not put a HUD in it.
	/// </summary>
	public static bool IsPreview( Scene scene ) => ItemIcons.IsIconScene( scene ) || AvatarPreview.IsPreviewScene( scene );

	protected override void OnUpdate()
	{
		if ( IsOpen )
		{
			// Escape closes the right-click menu first.
			if ( ContextMenu.IsOpen && Input.EscapePressed )
			{
				Input.EscapePressed = false;
				ContextMenu.Hide();
				return;
			}

			// The drop dialog on top of it takes Escape and the key.
			if ( !DropCashMenu.IsOpen
			     && (Input.EscapePressed || Input.Pressed( "CharacterMenu" ) || NaviInputCapture.Current is not null) )
			{
				Input.EscapePressed = false;
				Close();
			}
		}
		else if ( Input.Pressed( "CharacterMenu" ) && NaviInputCapture.Current is null && !GameMenus.IsAnyOpen )
		{
			Open();
		}

		if ( !IsOpen )
			return;

		Mouse.Visibility = MouseVisibility.Visible;
		FreeControls( false );
		ItemIcons.Spin();

		// The preview's panel is made by the first draw after the menu opens.
		if ( !dressed && Preview.IsValid() )
		{
			dressed = true;
			DressPreview();
		}
	}

	/// <summary>
	/// Put what the player wears on the preview, with the customizer's colors.
	/// </summary>
	void DressPreview()
	{
		var customizer = Scene.GetAllComponents<PlayerCustomizer>().FirstOrDefault();
		var outfit = customizer.IsValid() ? customizer.GetCurrentOutfit() : ClothingContainer.CreateFromLocalUser();
		var colors = customizer.IsValid() ? customizer.GetCurrentColors() : new Dictionary<string, Color>();

		Preview.SetOutfit( outfit, colors );
		Preview.ZoomFocus = Focus;
	}

	void SetFocus( object value )
	{
		Focus = (PreviewFocus)value;

		if ( Preview.IsValid() )
			Preview.ZoomFocus = Focus;
	}

	protected override void OnDisabled()
	{
		if ( IsOpen )
			Close();
	}

	void EndDrag( PanelEvent e )
	{
		if ( Window is { IsValid: true } )
			InventoryGrid.EndDrag( Mouse.Position, Window.Box.Rect, e );
		else
			InventoryGrid.Cancel();
	}

	void Open()
	{
		IsOpen = true;
		dressed = false;
		GameMenus.SetOpen( "character", true );
	}

	void Close()
	{
		IsOpen = false;
		GameMenus.SetOpen( "character", false );
		InventoryGrid.Cancel();
		WalletStrip.Cancel();
		FreeControls( true );
		Mouse.Visibility = MouseVisibility.Hidden;
	}

	/// <summary>
	/// Take the look and move controls from the player while the menu is open, or give them back.
	/// </summary>
	void FreeControls( bool allowed )
	{
		var controller = Players.LocalController;

		if ( controller is null )
			return;

		controller.UseLookControls = allowed;
		controller.UseInputControls = allowed;

		// The controller keeps the last move it was given, so a held key would walk on: zero it, as the Navi seat does.
		if ( !allowed )
			controller.WishVelocity = 0;
	}

	protected override int BuildHash()
	{
		// The dragged icon and the details follow the mouse.
		var following = InventoryGrid.Dragged is not null || InventoryGrid.HoveredItem is not null;
		return System.HashCode.Combine( IsOpen, InventoryGrid.State, following ? Mouse.Position : default, Focus );
	}
}
