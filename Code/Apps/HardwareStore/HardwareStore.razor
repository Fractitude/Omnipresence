@using Sandbox.UI
@inherits NaviApp
@namespace OmnipresenceApps

@* The game's own app for the store's computer. Not a system app: the computer has a StoreTerminal, which makes it a *@
@* kiosk with only this app, and the app refuses to work on any other computer. Described by *@
@* Assets/navi/shop/hardwarestore.napp. *@
@* It is shared: the host's copy takes the money, places the orders and runs the staff login puzzle (Level 1: a word *@
@* to guess from a clue), and everyone *@
@* near the screen watches. The password never reaches the state. *@

<root>
	@if ( !UiState.HasAccess )
	{
		<div class="message">@UiState.Message</div>
	}
	else if ( UiState.Screen is StoreScreen.Terminal or StoreScreen.Breached or StoreScreen.Locked )
	{
		<div class="head">
			<div class="back" @onclick=@( () => Navi.Act( HardwareStoreViewModel.TabAction, HardwareStoreViewModel.ShopTab ) )>&lt; Leave</div>
			<div class="host">Staff panel 13.0.55</div>
		</div>

		<div class="attempts">
			Attempts:
			@for ( var i = 0; i < UiState.MaxAttempts; i++ )
			{
				<span class="pip @( i < UiState.Attempts ? "on" : "" )"></span>
			}
		</div>

		@if ( UiState.Board is { } board )
		{
			<WordGuessBoard Board=@board Enabled=@( UiState.Screen == StoreScreen.Terminal ) OnSubmit=@WordEntered/>
		}
		else
		{
			<div class="body">
				<div class="dump">
					@foreach ( var line in UiState.Dump )
					{
						<div class="line">
							<span class="addr">@line.Address</span>
							@foreach ( var segment in line.Segments )
							{
								@if ( segment.Kind == DumpKind.Word && UiState.Screen == StoreScreen.Terminal )
								{
									<span class="word" @onclick=@( () => Navi.Act( HardwareStoreViewModel.GuessAction, segment.Index.ToString() ) )>@segment.Text</span>
								}
								else if ( segment.Kind == DumpKind.Trick && UiState.Screen == StoreScreen.Terminal )
								{
									<span class="trick" @onclick=@( () => Navi.Act( HardwareStoreViewModel.TrickAction, segment.Index.ToString() ) )>@segment.Text</span>
								}
								else
								{
									<span class="junk">@segment.Text</span>
								}
							}
						</div>
					}
				</div>

				<div class="log">
					@foreach ( var entry in UiState.Log )
					{
						<div class="entry">@entry</div>
					}
				</div>
			</div>
		}

		@if ( UiState.Screen == StoreScreen.Breached )
		{
			<div class="result good">
				<div class="result-title">ACCESS GRANTED</div>
				@foreach ( var reward in UiState.Rewards )
				{
					<div class="reward">@reward</div>
				}
				<div class="button" @onclick=@( () => Navi.Act( HardwareStoreViewModel.TabAction, HardwareStoreViewModel.StaffTab ) )>Open staff panel</div>
			</div>
		}
		else if ( UiState.Screen == StoreScreen.Locked )
		{
			<div class="result bad">
				<div class="result-title">TERMINAL LOCKED</div>
				<div class="reward">Security lockout: @UiState.Lockout</div>
				<div class="button" @onclick=@( () => Navi.Act( HardwareStoreViewModel.TabAction, HardwareStoreViewModel.ShopTab ) )>Leave</div>
			</div>
		}
	}
	else
	{
		<div class="top">
			<div class="store-title">Hardware Store</div>
			<div class="store-balance">@UiState.Balance</div>
		</div>

		<div class="tabs">
			<div class="tab @( UiState.Screen == StoreScreen.Shop ? "active" : "" )"
			     @onclick=@( () => Navi.Act( HardwareStoreViewModel.TabAction, HardwareStoreViewModel.ShopTab ) )>Shop</div>
			<div class="tab @( UiState.Screen == StoreScreen.Orders ? "active" : "" )"
			     @onclick=@( () => Navi.Act( HardwareStoreViewModel.TabAction, HardwareStoreViewModel.OrdersTab ) )>Orders</div>
			<div class="tab staff @( UiState.Screen is StoreScreen.Staff or StoreScreen.Login ? "active" : "" )"
			     @onclick=@( () => Navi.Act( HardwareStoreViewModel.TabAction, HardwareStoreViewModel.StaffTab ) )>Staff</div>
		</div>

		@if ( UiState.StaffOpen )
		{
			<div class="staff-banner">Staff access for @UiState.StaffRemaining. Prices are cut.</div>
		}

		@if ( UiState.Notice != "" )
		{
			<div class="notice">@UiState.Notice</div>
		}

		<div class="list">
			@if ( UiState.Screen == StoreScreen.Shop )
			{
				@foreach ( var row in UiState.Shop )
				{
					<div class="item">
						<div class="item-top">
							<div class="item-name">@row.Name</div>
							<div class="item-slot">@row.Slot</div>
						</div>
						<div class="item-description">@row.Description</div>
						<div class="item-effect">@row.Effect</div>

						@if ( row.Status == ShopStatus.NeedsBlueprint )
						{
							<div class="item-hint">@row.Hint</div>
						}
						else
						{
							<div class="buy-row">
								<div class="button @( row.Status == ShopStatus.Buy ? "" : "disabled" )"
								     @onclick=@( () => Navi.Act( HardwareStoreViewModel.BuyAction, row.Id ) )>Buy @row.Price</div>
								@if ( row.WasPrice != "" )
								{
									<div class="was-price">@row.WasPrice</div>
								}
							</div>
						}
					</div>
				}
			}
			else if ( UiState.Screen == StoreScreen.Orders )
			{
				@if ( UiState.Shipments.Count == 0 )
				{
					<div class="empty">Nothing on its way. Packages go straight to your home, and the Workbench there installs them.</div>
				}

				@foreach ( var row in UiState.Shipments )
				{
					<div class="item">
						<div class="item-top">
							<div class="item-name">@row.Name</div>
							<div class="eta">@row.Eta</div>
						</div>
						<div class="item-description">@( row.Rerouted ? "Rerouted from another customer's order." : "On its way to your home." )</div>
					</div>
				}
			}
			else if ( UiState.Screen == StoreScreen.Login )
			{
				<div class="item">
					<div class="item-name">Staff login</div>
					<div class="item-description">The shop's back office. Staff see other customers' orders and pay less. Security level 1: the password is a word, and the terminal gives a clue.</div>

					@if ( UiState.Lockout != "" )
					{
						<div class="item-hint">Security lockout: @UiState.Lockout</div>
					}
					else
					{
						<div class="button" @onclick=@( () => Navi.Act( HardwareStoreViewModel.LoginAction ) )>Break in</div>
					}
				</div>
			}
			else
			{
				@foreach ( var row in UiState.StaffOrders )
				{
					<div class="item">
						<div class="item-top">
							<div class="item-name">@row.Name</div>
							<div class="item-slot">order for @row.Customer</div>
						</div>
						<div class="item-effect">@row.Effect</div>

						@if ( row.Taken )
						{
							<div class="item-hint">Rerouted to you.</div>
						}
						else
						{
							<div class="button reroute"
							     @onclick=@( () => Navi.Act( HardwareStoreViewModel.RerouteAction, row.Id ) )>Reroute to my home</div>
						}
					</div>
				}
			}
		</div>
	}
</root>

@code
{
	/// <summary>
	/// The app's logic and its state, in the host's copy only. The seat is the computer's user, found through the window
	/// this panel is in.
	/// </summary>
	HardwareStoreViewModel ViewModel => field ??= new( GetSeat, AtStoreTerminal );

	HardwareStoreUiState UiState =>
		Navi.IsViewer ? Navi.GetState<HardwareStoreUiState>() ?? HardwareStoreUiState.Empty : ViewModel.UiState;

	void WordEntered( string word ) => Navi.Act( HardwareStoreViewModel.WordAction, word );

	bool AtStoreTerminal() => StoreTerminal.IsStore( GameAppSeat.ComputerOf( this ) );

	Connection GetSeat() => GameAppSeat.UserOf( this );

	public override void Tick()
	{
		base.Tick();

		if ( Navi.IsViewer )
			return;

		ViewModel.Tick();
		Navi.Publish( ViewModel.UiState );
	}

	protected override void OnAction( string action, string[] args ) => ViewModel.Act( action, args );

	protected override int BuildHash() => UiState.Revision;
}
