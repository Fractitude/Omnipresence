@using Sandbox.UI
@inherits NaviApp
@namespace OmnipresenceApps

@* The game's own system app, part of the OS: described by Assets/navi/system/thewired.napp, so it is always *@
@* installed and has root. *@
@* It is shared, so the host's copy moves the player in the seat; each viewer's window says where they are. *@

<root>
	@if ( UiState.OfflineHint is not null )
	{
		<i class="offline-icon">wifi_off</i>
		<div class="offline-heading">No internet access</div>
		<div class="offline-hint">@UiState.OfflineHint</div>
	}
	else
	{
		<div class="status">@UiState.Status</div>
	}

	@if ( UiState.ButtonText is not null )
	{
		<div class="button" @onclick=@( () => Navi.Act( TheWiredViewModel.CrossAction ) )>@UiState.ButtonText</div>
	}
</root>

@code
{
	/// <summary>
	/// The app's logic, in the host's copy only: it moves the player in the seat when the button is pressed.
	/// </summary>
	TheWiredViewModel ViewModel => field ??= new( GetSeat, GetComputer );

	Connection GetSeat() => GameAppSeat.UserOf( this );

	NaviComputer GetComputer() => GameAppSeat.ComputerOf( this );

	/// <summary>
	/// What this player's window says, from where they are: every viewer's own, whether or not they sit at the computer.
	/// </summary>
	TheWiredUiState UiState => TheWiredViewModel.Describe( WiredTravel.PlaceOf( Connection.Local ), GetComputer() );

	protected override void OnAction( string action, string[] args ) => ViewModel.Act( action, args );

	protected override int BuildHash() => UiState.Revision;
}
