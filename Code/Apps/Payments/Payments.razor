@using Sandbox.UI
@inherits NaviApp
@namespace OmnipresenceApps

@* The game's own app, described by Assets/navi/game/payments.napp: an ordinary app the player *@
@* installs from Packages, and can uninstall again. It is not an OS app. *@
@* It is shared: the host's copy moves the money, and every player sees the same window. Whoever pays is the player *@
@* in the seat, worked out on the host, never from what the panel sends. *@

<root>
	@if ( UiState.OfflineHint is not null )
	{
		<div class="offline">
			<i>wifi_off</i>
			<div class="offline-heading">No internet access</div>
			<div class="offline-hint">@UiState.OfflineHint</div>
		</div>
	}
	else if ( !UiState.HasAccount )
	{
		<div class="message">@UiState.Message</div>
	}
	else if ( UiState.Screen == PaymentsScreen.Success && UiState.Target is { } paid )
	{
		<div class="success">
			<div class="burst">
				<div class="ring"></div>
				<div class="ring late"></div>
				<div class="badge"><i>check</i></div>
			</div>
			<div class="sent-amount">
				<div class="figure">@UiState.SentAmount</div>
				@if ( UiState.Currency == PaymentsCurrency.Crypto )
				{
					<div class="ticker">@PaymentsUiState.CryptoUnit</div>
				}
			</div>
			<div class="sent-to">sent to @paid.Name</div>
			<div class="button done" @onclick=@( () => Navi.Act( PaymentsViewModel.BackAction ) )>Done</div>
		</div>
	}
	else if ( UiState.Screen == PaymentsScreen.Send && UiState.Target is { } target )
	{
		<div class="topbar">
			<div class="back" @onclick=@( () => Navi.Act( PaymentsViewModel.BackAction ) )><i>arrow_back</i></div>
			<div class="title">
				Send @( UiState.Currency == PaymentsCurrency.Crypto ? PaymentsUiState.CryptoName : "money" )
			</div>
		</div>

		<div class="recipient">
			<div class="avatar big">@target.Initial</div>
			<div class="recipient-name">@target.Name</div>
			<div class="recipient-hint">
				<div class="caption">Available</div>
				<div class="figure">
					@( UiState.Currency == PaymentsCurrency.Crypto ? UiState.Crypto : UiState.Balance )
				</div>
				@if ( UiState.Currency == PaymentsCurrency.Crypto )
				{
					<div class="ticker">@PaymentsUiState.CryptoUnit</div>
				}
			</div>
		</div>

		<div class="quick">
			@foreach ( var option in SendCurrencies )
			{
				<div class="chip @( UiState.Currency == option ? "on" : "" )"
				     @onclick=@( () => Navi.Act( PaymentsViewModel.CurrencyAction, option.ToString() ) )>
					@( option == PaymentsCurrency.Crypto ? PaymentsUiState.CryptoName : "Dollars" )
				</div>
			}
		</div>

		<div class="send">
			<div class="currency">@( UiState.Currency == PaymentsCurrency.Crypto ? "" : "$" )</div>
			<TextEntry @ref=AmountEntry class="amount" Value=@( UiState.Amount ) Placeholder="0" MaxLength=@( 12 )
			           OnTextEdited=@AmountEdited/>
			@if ( UiState.Currency == PaymentsCurrency.Crypto )
			{
				<div class="ticker">@PaymentsUiState.CryptoUnit</div>
			}
		</div>

		<div class="quick">
			@foreach ( var value in QuickAmounts )
			{
				<div class="chip" @onclick=@( () => SetAmount( value ) )>
					@( UiState.Currency == PaymentsCurrency.Crypto ? value : $"${value}" )
				</div>
			}
		</div>

		@if ( UiState.Notice != "" )
		{
			<div class="notice">@UiState.Notice</div>
		}

		<div class="button confirm" @onclick=@( () => Navi.Act( PaymentsViewModel.SendAction ) )>
			@ConfirmLabel
		</div>
	}
	else if ( UiState.Screen == PaymentsScreen.Exchange && UiState.Exchange is { } exchange )
	{
		var convert = exchange.Tab == ExchangeTab.Convert;

		@* Three tabs over one card: the amount typed, and under it what it deals. Buying and selling say which *@
		@* currency the number is in with a two-way switch beside it; converting says it with the currency pills of *@
		@* its two rows, and shows what comes back in the second. *@
		<div class="topbar">
			<div class="back" @onclick=@( () => Navi.Act( PaymentsViewModel.BackAction ) )><i>arrow_back</i></div>
			<div class="title">Exchange</div>
			<div class="venue">@UiState.ExchangeName</div>
		</div>

		<div class="tabs">
			@foreach ( var option in ExchangeTabs )
			{
				<div class="tab @( exchange.Tab == option ? "active" : "" )" @onclick=@( () => PickTab( option ) )>
					@option
				</div>
			}
		</div>

		<div class="exchange-body">
			<div class="trade-card">
				<div class="trade-top">
					@if ( convert )
					{
						<div class="picker" @onclick=@Swap>
							<div class="picker-name">@CurrencyName( exchange.Unit )</div>
							<i>swap_vert</i>
						</div>
					}
					else
					{
						<div class="entry-caption">@exchange.EntryLabel</div>
					}
					<div class="available">@exchange.Available</div>
				</div>

				<div class="amount-row">
					@if ( exchange.Unit == PaymentsCurrency.Dollars )
					{
						<div class="sign">$</div>
					}
					<TextEntry @ref=ExchangeEntry class="amount" Value=@( exchange.Amount ) Placeholder="0"
					           MaxLength=@( 12 ) OnTextEdited=@ExchangeAmountEdited/>
					@if ( exchange.Unit == PaymentsCurrency.Crypto )
					{
						<div class="ticker">@PaymentsUiState.CryptoUnit</div>
					}
					@if ( !convert )
					{
						<div class="unit-toggle">
							@foreach ( var option in ExchangeUnits )
							{
								<div class="unit @( exchange.Unit == option ? "on" : "" )" @onclick=@( () => PickUnit( option ) )>
									@SignOf( option )
								</div>
							}
						</div>
					}
				</div>

				@if ( !convert )
				{
					<div class="quick">
						@foreach ( var chip in exchange.Quick )
						{
							<div class="chip" @onclick=@( () => PickQuick( chip ) )>@chip.Label</div>
						}
					</div>
				}
			</div>

			@if ( convert )
			{
				<div class="swap" @onclick=@Swap><i>arrow_downward</i></div>

				<div class="trade-card">
					<div class="trade-top">
						<div class="picker static"><div class="picker-name">@CurrencyName( exchange.To )</div></div>
						<div class="available">after the fee</div>
					</div>

					<div class="amount-row">
						<div class="figure">@exchange.ResultFigure</div>
						@if ( exchange.To == PaymentsCurrency.Crypto )
						{
							<div class="ticker">@PaymentsUiState.CryptoUnit</div>
						}
					</div>
				</div>

				<div class="quick">
					@foreach ( var chip in exchange.Quick )
					{
						<div class="chip" @onclick=@( () => PickQuick( chip ) )>@chip.Label</div>
					}
				</div>
			}

			@if ( exchange.Hint != "" )
			{
				<div class="hint">@exchange.Hint</div>
			}

			@* What the deal costs, on every tab: the rate, the cut, and — where the result is not already the big figure *@
			@* of a row above — what comes back. *@
			<div class="deal">
				<div class="deal-row">
					<div class="deal-label">Rate</div>
					<div class="deal-value">@exchange.Rate</div>
				</div>
				<div class="deal-row">
					<div class="deal-label">You lose</div>
					<div class="deal-value loss">@exchange.FeeText</div>
				</div>
				@if ( !convert )
				{
					<div class="deal-row">
						<div class="deal-label">You get</div>
						<div class="deal-value strong">@exchange.ResultText</div>
					</div>
				}
			</div>

			@if ( UiState.Notice != "" )
			{
				<div class="notice @( UiState.NoticeGood ? "ok" : "" )">@UiState.Notice</div>
			}

			<div class="button confirm" @onclick=@( () => Navi.Act( PaymentsViewModel.TradeAction ) )>
				@exchange.ActionLabel
			</div>
		</div>
	}
	else
	{
		<div class="card">
			<div class="card-top">
				<div class="card-label">Available balance</div>
				<div class="card-owner">@UiState.Owner</div>
			</div>
			<div class="balance">@UiState.Balance</div>
			<div class="card-crypto">
				<div class="figure">@UiState.Crypto</div>
				<div class="ticker">@PaymentsUiState.CryptoUnit</div>
			</div>
		</div>

		<div class="action-row" @onclick=@( () => Navi.Act( PaymentsViewModel.ExchangeAction ) )>
			<div class="icon"><i>swap_horiz</i></div>
			<div class="details">
				<div class="peer">Exchange</div>
				<div class="when">Buy, sell or convert @PaymentsUiState.CryptoName</div>
			</div>
			<i class="go">chevron_right</i>
		</div>

		<div class="section">
			<div class="heading">Send to</div>
			<div class="payees">
				@if ( UiState.Payees.Count == 0 )
				{
					<div class="empty">No other players online.</div>
				}

				@foreach ( var payee in UiState.Payees )
				{
					<div class="payee" @onclick=@( () => Navi.Act( PaymentsViewModel.ChooseAction, payee.Id ) )>
						<div class="avatar">@payee.Initial</div>
						<div class="name">@payee.Name</div>
						<i class="go">chevron_right</i>
					</div>
				}
			</div>
			@if ( UiState.Notice != "" )
			{
				<div class="notice">@UiState.Notice</div>
			}
		</div>

		<div class="section grow">
			<div class="heading">Activity</div>
			<div class="history">
				@if ( UiState.History.Count == 0 )
				{
					<div class="empty">No activity yet.</div>
				}

				@foreach ( var row in UiState.History )
				{
					<div class="row">
						<div class="avatar @( row.Incoming ? "in" : "out" )">@row.Initial</div>
						<div class="details">
							<div class="top">
								<div class="peer">@row.Peer</div>
								<div class="amount @( row.Incoming ? "in" : "out" )">
									<div class="figure">@row.Amount</div>
									@if ( row.Crypto )
									{
										<div class="ticker">@PaymentsUiState.CryptoUnit</div>
									}
								</div>
							</div>
							<div class="meta">
								<div class="kind">@row.Kind</div>
								<div class="when">@row.When</div>
							</div>
						</div>
					</div>
				}
			</div>
		</div>
	}
</root>

@code
{
	static readonly string[] QuickAmounts = ["10", "50", "100", "500"];

	/// <summary>A property, not a static field: a hot reload keeps a static array of the assembly's own enum.</summary>
	static PaymentsCurrency[] SendCurrencies => System.Enum.GetValues<PaymentsCurrency>();

	/// <summary>The Exchange tabs and the currencies it deals in, for the same reason.</summary>
	static ExchangeTab[] ExchangeTabs => System.Enum.GetValues<ExchangeTab>();

	static PaymentsCurrency[] ExchangeUnits => [PaymentsCurrency.Dollars, PaymentsCurrency.Crypto];

	/// <summary>
	/// The app's logic and its state, in the host's copy only. The seat is the computer's user, found through the window
	/// this panel is in.
	/// </summary>
	PaymentsViewModel ViewModel => field ??= new( GetSeat, GetComputer );

	PaymentsUiState UiState =>
		Navi.IsViewer ? Navi.GetState<PaymentsUiState>() ?? PaymentsUiState.Empty : ViewModel.UiState;

	/// <summary>
	/// The amount fields of a payment and of the exchange. Plain view plumbing: what is typed goes to the host as it
	/// changes, and comes back in the state.
	/// </summary>
	TextEntry AmountEntry { get; set; }

	TextEntry ExchangeEntry { get; set; }

	/// <summary>The trade count the field was last emptied for; -1 until the first frame of the Exchange screen.</summary>
	int settledSeen = -1;

	/// <summary>The confirm button says what it sends, so nobody sends Ethereum thinking they sent dollars.</summary>
	string ConfirmLabel => UiState.Currency == PaymentsCurrency.Crypto
		? $"Confirm and send {PaymentsUiState.CryptoUnit}"
		: "Confirm and send";

	Connection GetSeat() => GameAppSeat.UserOf( this );

	NaviComputer GetComputer() => GameAppSeat.ComputerOf( this );

	/// <summary>Whole numbers only: anything else typed or pasted is dropped before the host hears of it.</summary>
	void AmountEdited( string text )
	{
		var digits = new string( text.Where( char.IsAsciiDigit ).ToArray() );

		if ( digits != text )
			AmountEntry.Text = digits;

		Navi.Act( PaymentsViewModel.AmountAction, digits );
	}

	void SetAmount( string digits )
	{
		if ( AmountEntry is not null )
			AmountEntry.Text = digits;

		Navi.Act( PaymentsViewModel.AmountAction, digits );
	}

	void ExchangeAmountEdited( string text )
	{
		var digits = new string( text.Where( char.IsAsciiDigit ).ToArray() );

		if ( digits != text && ExchangeEntry is { IsValid: true } )
			ExchangeEntry.Text = digits;

		Navi.Act( PaymentsViewModel.ExchangeAmountAction, digits );
	}

	/// <summary>The way round on Convert: there are only two currencies, so the other one is the answer.</summary>
	void Swap() => PickUnit( UiState.Exchange?.To ?? PaymentsCurrency.Dollars );

	void PickTab( ExchangeTab tab )
	{
		EmptyAmount();
		Navi.Act( PaymentsViewModel.ExchangeTabAction, tab.ToString() );
	}

	/// <summary>
	/// Type the amount in another currency, or turn Convert the other way round. The field empties, as the host empties
	/// its own copy: a hundred dollars is not a hundred Ethereum.
	/// </summary>
	void PickUnit( PaymentsCurrency unit )
	{
		EmptyAmount();
		Navi.Act( PaymentsViewModel.ExchangeUnitAction, unit.ToString() );
	}

	/// <summary>
	/// A quick button fills the field itself, with the digits the host works out for it too, because the field keeps what
	/// was typed into it and would not take them from the state.
	/// </summary>
	void PickQuick( QuickChip chip )
	{
		if ( ExchangeEntry is { IsValid: true } )
			ExchangeEntry.Text = chip.Digits;

		Navi.Act( PaymentsViewModel.QuickAction, chip.Key );
	}

	void EmptyAmount()
	{
		if ( ExchangeEntry is { IsValid: true } )
			ExchangeEntry.Text = "";
	}

	static string CurrencyName( PaymentsCurrency unit ) =>
		unit == PaymentsCurrency.Dollars ? "Dollars" : PaymentsUiState.CryptoName;

	static string SignOf( PaymentsCurrency unit ) =>
		unit == PaymentsCurrency.Dollars ? "$" : PaymentsUiState.CryptoUnit;

	public override void Tick()
	{
		base.Tick();

		if ( !Navi.IsViewer )
		{
			ViewModel.Tick();
			Navi.Publish( ViewModel.UiState );
		}

		if ( UiState.Exchange is not { } exchange )
			return;

		// A trade empties the amount on the host, and the field keeps whatever it was given, so it is emptied here too.
		if ( settledSeen < 0 )
			settledSeen = exchange.Settled;
		else if ( exchange.Settled != settledSeen )
		{
			settledSeen = exchange.Settled;
			EmptyAmount();
		}
	}

	protected override void OnAction( string action, string[] args ) => ViewModel.Act( action, args );

	protected override int BuildHash() => UiState.Revision;
}
