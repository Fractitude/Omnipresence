@using Sandbox.UI
@inherits NaviApp
@namespace OmnipresenceApps

@* The game's own system app, part of the OS: described by Assets/navi/system/workbench.napp, so it is always *@
@* installed and has root. *@
@* It only installs hardware: buying is done at the Hardware Store. It is shared: the host's copy moves the *@
@* hardware, and every player sees the same window. Only works at home. *@

<root>
	@if ( !UiState.HasAccess )
	{
		<div class="message">@UiState.Message</div>
	}
	else
	{
		<div class="bench-title">Workbench</div>

		@if ( UiState.Notice != "" )
		{
			<div class="notice">@UiState.Notice</div>
		}

		<div class="section">
			<div class="heading">Your rig</div>
			<div class="rig">
				@foreach ( var slot in UiState.Rig )
				{
					<div class="slot @( slot.Id == "" ? "empty-slot" : "" )">
						<div class="slot-kind">@slot.Slot</div>

						@if ( slot.Id == "" )
						{
							<div class="slot-name">Empty</div>
						}
						else
						{
							<div class="slot-body">
								<div class="slot-name">@slot.Name</div>
								<div class="slot-effect">@slot.Effect</div>
							</div>
							<div class="small-button" @onclick=@( () => Navi.Act( WorkbenchViewModel.RemoveAction, slot.Id ) )>Remove</div>
						}
					</div>
				}
			</div>
			<div class="summary">@UiState.Summary</div>
		</div>

		<div class="section grow">
			<div class="heading">Parts</div>
			<div class="list">
				@if ( UiState.Inventory.Count == 0 )
				{
					<div class="empty">No spare parts. Order some at the Hardware Store.</div>
				}

				@foreach ( var row in UiState.Inventory )
				{
					<div class="item">
						<div class="item-body">
							<div class="item-name">@row.Name @( row.Count > 1 ? $"x{row.Count}" : "" )</div>
							<div class="item-effect">@row.Slot: @row.Effect</div>
						</div>
						<div class="button @( row.CanInstall ? "" : "disabled" )"
						     @onclick=@( () => Navi.Act( WorkbenchViewModel.InstallAction, row.Id ) )>Install</div>
					</div>
				}
			</div>

			@if ( UiState.Incoming != "" )
			{
				<div class="incoming">@UiState.Incoming</div>
			}
		</div>
	}
</root>

@code
{
	/// <summary>
	/// The app's logic and its state, in the host's copy only. The seat is the computer's user, found through the window
	/// this panel is in.
	/// </summary>
	WorkbenchViewModel ViewModel => field ??= new( GetSeat );

	WorkbenchUiState UiState =>
		Navi.IsViewer ? Navi.GetState<WorkbenchUiState>() ?? WorkbenchUiState.Empty : ViewModel.UiState;

	Connection GetSeat()
	{
		if ( AncestorsAndSelf.OfType<NaviAppHost>().FirstOrDefault()?.Computer is not { HasUser: true } computer )
			return null;

		return Networking.IsActive ? computer.User : Connection.Local;
	}

	public override void Tick()
	{
		base.Tick();

		if ( Navi.IsViewer )
			return;

		ViewModel.Tick();
		Navi.Publish( ViewModel.UiState );
	}

	protected override void OnAction( string action, string[] args ) => ViewModel.Act( action, args );

	protected override int BuildHash() => UiState.Revision;
}
