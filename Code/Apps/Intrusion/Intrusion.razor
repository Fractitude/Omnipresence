@using Sandbox.UI
@inherits NaviApp
@namespace OmnipresenceApps

@* The game's own app, described by Assets/navi/game/intrusion.napp: an ordinary app the player *@
@* installs from Packages, and can uninstall again. It is not an OS app. *@
@* It is shared: the host's copy runs the puzzle and pays the rewards, and everyone near the screen watches the *@
@* same terminal. The password never reaches the state. *@

<root>
	@if ( !UiState.HasAccess )
	{
		<div class="message">@UiState.Message</div>
	}
	else if ( UiState.Screen == IntrusionScreen.Operation && UiState.Operation is { } operation )
	{
		<div class="head">
			<div class="back" @onclick=@( () => Navi.Act( IntrusionViewModel.BackAction ) )>&lt; Disconnect</div>
			<div class="host">@operation.Name @operation.Address</div>
		</div>

		<OperationBoard View=@operation Rewards=@UiState.Rewards OnAct=@OperationActed
		                OnDisconnect=@( () => Navi.Act( IntrusionViewModel.BackAction ) )/>
	}
	else if ( UiState.Screen is IntrusionScreen.Servers or IntrusionScreen.Operations or IntrusionScreen.Blueprints )
	{
		<div class="skill">
			<span>Hacking Lv @UiState.HackLevel</span>
			<div class="skill-bar">
				<div class="skill-fill" style="width: @( UiState.HackProgress * 100f )%"></div>
			</div>
		</div>

		<div class="tabs">
			<div class="tab @( UiState.Screen == IntrusionScreen.Servers ? "active" : "" )"
			     @onclick=@( () => Navi.Act( IntrusionViewModel.TabAction, IntrusionViewModel.ServersTab ) )>Servers</div>
			<div class="tab @( UiState.Screen == IntrusionScreen.Operations ? "active" : "" )"
			     @onclick=@( () => Navi.Act( IntrusionViewModel.TabAction, IntrusionViewModel.OperationsTab ) )>Operations</div>
			<div class="tab @( UiState.Screen == IntrusionScreen.Blueprints ? "active" : "" )"
			     @onclick=@( () => Navi.Act( IntrusionViewModel.TabAction, IntrusionViewModel.BlueprintsTab ) )>Blueprints</div>
		</div>

		@if ( UiState.Screen == IntrusionScreen.Servers )
		{
			<div class="list">
				@foreach ( var row in UiState.Servers )
				{
					<div class="server @( row.Cleared ? "cleared" : "" )"
					     @onclick=@( () => Navi.Act( IntrusionViewModel.OpenAction, row.Id ) )>
						<div class="server-top">
							<div class="server-name">@row.Name</div>
							<div class="difficulty @row.Difficulty.ToLowerInvariant()">@row.Difficulty</div>
						</div>
						<div class="server-meta">@row.Address - @row.Layer - Security level @row.Level</div>
						<div class="server-blurb">@row.Blurb</div>
						<div class="server-reward">@( row.Cleared ? "Breached" : row.Reward )</div>
					</div>
				}
			</div>
		}
		else if ( UiState.Screen == IntrusionScreen.Operations )
		{
			<div class="list">
				@foreach ( var row in UiState.Operations )
				{
					<div class="server @( row.Locked ? "cleared" : "" )"
					     @onclick=@( () => Navi.Act( IntrusionViewModel.OperationOpenAction, row.Id ) )>
						<div class="server-top">
							<div class="server-name">@row.Name</div>
							<div class="difficulty @row.Difficulty.ToLowerInvariant()">@row.Difficulty</div>
						</div>
						<div class="server-meta">@row.Address - @row.Layer - Hacking Lv @row.MinLevel</div>
						<div class="server-blurb">@row.Blurb</div>
						<div class="server-reward">@( row.Locked ? $"Needs hacking level {row.MinLevel}" : row.Reward )</div>
						@if ( row.Best != "" )
						{
							<div class="server-meta">Best run: @row.Best</div>
						}
					</div>
				}
			</div>
		}
		else
		{
			<div class="list">
				@if ( UiState.Blueprints.Count == 0 )
				{
					<div class="empty">No blueprints yet. Some dead servers hold them.</div>
				}

				@foreach ( var row in UiState.Blueprints )
				{
					<div class="server">
						<div class="server-name">@row.Name</div>
						<div class="server-blurb">@row.Description</div>
						<div class="server-meta">Found on @row.From. Buy it at the Hardware Store.</div>
					</div>
				}
			</div>
		}
	}
	else
	{
		<div class="head">
			<div class="back" @onclick=@( () => Navi.Act( IntrusionViewModel.BackAction ) )>&lt; Disconnect</div>
			<div class="host">@UiState.ServerName @UiState.ServerAddress</div>
		</div>

		<div class="attempts">
			Attempts:
			@for ( var i = 0; i < UiState.MaxAttempts; i++ )
			{
				<span class="pip @( i < UiState.Attempts ? "on" : "" )"></span>
			}
		</div>

		@if ( UiState.Board is { } board )
		{
			<WordGuessBoard Board=@board Enabled=@( UiState.Screen == IntrusionScreen.Terminal ) OnSubmit=@WordEntered/>
		}
		else
		{
			<div class="body">
				<div class="dump">
					@foreach ( var line in UiState.Dump )
					{
						<div class="line">
							<span class="addr">@line.Address</span>
							@foreach ( var segment in line.Segments )
							{
								@if ( segment.Kind == DumpKind.Word && UiState.Screen == IntrusionScreen.Terminal )
								{
									<span class="word" @onclick=@( () => Navi.Act( IntrusionViewModel.GuessAction, segment.Index.ToString() ) )>@segment.Text</span>
								}
								else if ( segment.Kind == DumpKind.Trick && UiState.Screen == IntrusionScreen.Terminal )
								{
									<span class="trick" @onclick=@( () => Navi.Act( IntrusionViewModel.TrickAction, segment.Index.ToString() ) )>@segment.Text</span>
								}
								else
								{
									<span class="junk">@segment.Text</span>
								}
							}
						</div>
					}
				</div>

				<div class="log">
					@foreach ( var entry in UiState.Log )
					{
						<div class="entry">@entry</div>
					}
				</div>
			</div>
		}

		@if ( UiState.Screen == IntrusionScreen.Breached )
		{
			<div class="result good">
				<div class="result-title">ACCESS GRANTED</div>
				@foreach ( var reward in UiState.Rewards )
				{
					<div class="reward">@reward</div>
				}
				<div class="button" @onclick=@( () => Navi.Act( IntrusionViewModel.BackAction ) )>Disconnect</div>
			</div>
		}
		else if ( UiState.Screen == IntrusionScreen.Locked )
		{
			<div class="result bad">
				<div class="result-title">TERMINAL LOCKED</div>
				<div class="button" @onclick=@( () => Navi.Act( IntrusionViewModel.RetryAction ) )>Try again</div>
				<div class="button" @onclick=@( () => Navi.Act( IntrusionViewModel.BackAction ) )>Disconnect</div>
			</div>
		}
	}
</root>

@code
{
	/// <summary>
	/// The app's logic and its state, in the host's copy only. The seat is the computer's user, found through the window
	/// this panel is in.
	/// </summary>
	IntrusionViewModel ViewModel => field ??= new( GetSeat );

	IntrusionUiState UiState =>
		Navi.IsViewer ? Navi.GetState<IntrusionUiState>() ?? IntrusionUiState.Empty : ViewModel.UiState;

	void OperationActed( string[] args ) => Navi.Act( IntrusionViewModel.OperationAction, args );

	void WordEntered( string word ) => Navi.Act( IntrusionViewModel.WordAction, word );

	Connection GetSeat() => GameAppSeat.UserOf( this );

	public override void Tick()
	{
		base.Tick();

		if ( Navi.IsViewer )
			return;

		ViewModel.Tick();
		Navi.Publish( ViewModel.UiState );
	}

	protected override void OnAction( string action, string[] args ) => ViewModel.Act( action, args );

	protected override int BuildHash() => UiState.Revision;
}
