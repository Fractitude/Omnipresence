@using Sandbox.UI
@inherits NaviApp
@namespace OmnipresenceApps

@* The game's own app for the car dealership's computer, described by Assets/navi/shop/cardealership.napp. Not a system *@
@* app: the computer needs the tag `store` (the manifest lists it too), and the app refuses to work on any other. *@
@* It is shared: the host's copy takes the money and makes the car at a free delivery point, and everyone near the screen *@
@* watches. The 3D picture (CarPreviewScene) is each client's own view: the car shown is shared, but turning and zooming *@
@* it is not. See docs/car-dealership.md. *@

<root>
	@if ( !UiState.HasAccess )
	{
		<div class="message">@UiState.Message</div>
	}
	else
	{
		<div class="top">
			<div class="dealer-title">Car Dealership</div>
			<div class="dealer-balance">@UiState.Balance</div>
		</div>

		<div class="body">
			<div class="garage">
				@foreach ( var car in UiState.Cars )
				{
					var id = car.Id;

					<div @key=@id class="car @( id == UiState.SelectedId ? "selected" : "" )"
					     @onclick=@( () => Navi.Act( CarDealershipViewModel.SelectAction, id ) )>
						<div class="car-name">@car.Name</div>
						<div class="car-price @( car.CanAfford ? "" : "short" )">@car.Price</div>
					</div>
				}
			</div>

			<div class="showroom">
				<ScenePanel @ref="View" class="view"/>
				<div class="view-hint">Drag to turn, scroll to zoom</div>

				@if ( pickerPart != "" && UiState.CanPaint )
				{
					<div class="picker-pop">
						<ColorPickerControl @ref="Picker"/>
						<div class="button" @onclick=@( () => TogglePicker( pickerPart ) )>Done</div>
					</div>
				}

				@if ( UiState.Selected is { } selected )
				{
					<div class="details">
						<div class="details-top">
							<div class="details-name">@selected.Name</div>
							<div class="details-price">@selected.Price</div>
						</div>
						<div class="details-description">@selected.Description</div>

						@if ( UiState.CanPaint )
						{
							<div class="paint-row">
								<div class="paint-label">Body</div>
								<div class="swatch big @( pickerPart == CarDealershipViewModel.BodyPart ? "selected" : "" )"
								     style="background-color: @CssOf( UiState.Paint )"
								     @onclick=@( () => TogglePicker( CarDealershipViewModel.BodyPart ) )>
								</div>

								@if ( UiState.CanTrim )
								{
									<div class="paint-label">Trim</div>
									<div class="swatch big @( pickerPart == CarDealershipViewModel.TrimPart ? "selected" : "" )"
									     style="background-color: @CssOf( UiState.Secondary )"
									     @onclick=@( () => TogglePicker( CarDealershipViewModel.TrimPart ) )>
									</div>
								}

								<div class="link" @onclick=@( () => ResetColours() )>Stock</div>
							</div>

							<div class="paint-row">
								<div class="paint-label">Glass</div>
								<div class="swatch @( UiState.Glass == UiState.StockGlass ? "selected" : "" )"
								     style="@GlassStyle( UiState.StockGlass )"
								     @onclick=@( () => Navi.Act( CarDealershipViewModel.PaintAction, CarDealershipViewModel.GlassPart, CarDealershipViewModel.StockArg ) )>
								</div>

								@foreach ( var tint in GlassTints )
								{
									var value = CarLook.Format( tint );

									<div @key=@value
									     class="swatch @( UiState.Glass == value ? "selected" : "" )"
									     style="@GlassStyle( value )"
									     @onclick=@( () => Navi.Act( CarDealershipViewModel.PaintAction, CarDealershipViewModel.GlassPart, value ) )>
									</div>
								}
							</div>
						}

						@if ( UiState.Notice != "" )
						{
							<div class="notice @( UiState.NoticeIsError ? "error" : "" )">@UiState.Notice</div>
						}

						<div class="buy-row">
							<div class="button @( selected.CanAfford && !UiState.Busy ? "" : "disabled" )"
							     @onclick=@( () => Navi.Act( CarDealershipViewModel.BuyAction, selected.Id ) )>
								@( UiState.Busy ? "Please wait..." : $"Buy for {selected.Price}" )
							</div>
							<div class="bays">@UiState.Bays</div>
						</div>
					</div>
				}
			</div>
		</div>
	}
</root>

@code
{
	/// <summary>
	/// The app's logic and its state, in the host's copy only. The seat is the computer's user, found through the window
	/// this panel is in.
	/// </summary>
	CarDealershipViewModel ViewModel => field ??= new( GetSeat, GetComputer );

	CarDealershipUiState UiState =>
		Navi.IsViewer ? Navi.GetState<CarDealershipUiState>() ?? CarDealershipUiState.Empty : ViewModel.UiState;

	Connection GetSeat() => GameAppSeat.UserOf( this );

	NaviComputer GetComputer() => GameAppSeat.ComputerOf( this );

	ScenePanel View { get; set; }

	/// <summary>
	/// The glass tints on offer besides the car's own: the colour is the tint and the alpha is how strong it is, from
	/// smoked glass to a blacked-out window, then colours.
	/// </summary>
	static readonly Color[] GlassTints =
	[
		new( 0.55f, 0.55f, 0.55f, 0.35f ), // light smoke
		new( 0.18f, 0.18f, 0.18f, 0.65f ), // dark smoke
		new( 0f, 0f, 0f, 1f ), // blacked out
		new( 0.23f, 0.51f, 0.96f, 0.45f ), // blue
		new( 0.13f, 0.77f, 0.37f, 0.45f ), // green
		new( 0.96f, 0.62f, 0.04f, 0.45f ), // amber
		new( 0.94f, 0.27f, 0.27f, 0.45f ), // red
		new( 0.66f, 0.33f, 0.97f, 0.45f ), // purple
	];

	// The part the engine's colour picker is open for, or "". Only this client's view, like the camera.
	string pickerPart = "";
	string boundPart = "";

	ColorPickerControl Picker { get; set; }

	// What the picker edits (it works on a serialized property), and what was last sent to the host from it.
	readonly CarColorHolder holder = new();
	SerializedObject holderObject;
	Color lastSent;
	RealTimeSince sinceSent;

	/// <summary>How often a colour dragged in the picker is sent to the host, in seconds.</summary>
	const float PickInterval = 0.08f;

	static string CssOf( string colour ) => CarLook.Parse( colour ) is { } c ? c.WithAlpha( 1 ).Hex : "#000000";

	/// <summary>The glass swatch: its tint, as strong as the glass is (a clear pane is a faint swatch).</summary>
	static string GlassStyle( string colour ) =>
		CarLook.Parse( colour ) is { } c
			? $"background-color: {c.WithAlpha( 1 ).Hex}; opacity: {System.Math.Max( c.a, 0.3f ).ToString( "0.##", System.Globalization.CultureInfo.InvariantCulture )}"
			: "";

	void TogglePicker( string part )
	{
		pickerPart = pickerPart == part ? "" : part;
		boundPart = "";
		StateHasChanged();
	}

	void ResetColours()
	{
		Navi.Act( CarDealershipViewModel.PaintAction, CarDealershipViewModel.BodyPart, CarDealershipViewModel.StockArg );
		Navi.Act( CarDealershipViewModel.PaintAction, CarDealershipViewModel.TrimPart, CarDealershipViewModel.StockArg );
		Navi.Act( CarDealershipViewModel.PaintAction, CarDealershipViewModel.GlassPart, CarDealershipViewModel.StockArg );
	}

	/// <summary>The car's colours as the screen shows them, or null when the car can't be painted.</summary>
	CarLook? ShownLook() =>
		UiState.CanPaint
		&& CarLook.Parse( UiState.Paint ) is { } body
		&& CarLook.Parse( UiState.Secondary ) is { } trim
		&& CarLook.Parse( UiState.Glass ) is { } glass
			? new CarLook( body, trim, glass )
			: null;

	/// <summary>
	/// Point the engine's colour picker at the part that was just opened, then send what is picked to the host while it
	/// is dragged. The picker is the engine's control, so it only edits <see cref="holder"/>; the host decides.
	/// </summary>
	void UpdatePicker()
	{
		// The car was changed to one with no trim while the trim picker was open.
		if ( pickerPart == CarDealershipViewModel.TrimPart && !UiState.CanTrim )
			pickerPart = "";

		if ( pickerPart == "" || Picker is not { IsValid: true } )
			return;

		if ( boundPart != pickerPart )
		{
			boundPart = pickerPart;
			holder.Value = CarLook.Parse( pickerPart == CarDealershipViewModel.BodyPart ? UiState.Paint : UiState.Secondary ) ?? Color.White;
			lastSent = holder.Value;
			holderObject = TypeLibrary.GetSerializedObject( holder );
			Picker.Property = holderObject.GetProperty( nameof(CarColorHolder.Value) );
			return;
		}

		if ( holder.Value != lastSent && sinceSent > PickInterval )
		{
			lastSent = holder.Value;
			sinceSent = 0;
			Navi.Act( CarDealershipViewModel.PaintAction, pickerPart, CarLook.Format( holder.Value ) );
		}
	}

	/// <summary>Degrees the car turns per pixel the mouse is dragged, across and up.</summary>
	const float DragDegrees = 0.5f;

	/// <summary>Seconds without a touch before the car turns by itself, and how fast.</summary>
	const float IdleBeforeSpin = 3f;
	const float SpinSpeed = 18f;

	// This client's own view of the car: the scene is view plumbing, rebuilt from the state, and holds no app state.
	CarPreviewScene preview;

	bool dragging;
	Vector2 lastMouse;
	RealTimeSince sinceTouched;

	public override void Tick()
	{
		base.Tick();

		if ( !Navi.IsViewer )
		{
			ViewModel.Tick();
			Navi.Publish( ViewModel.UiState );
		}

		UpdatePreview();
		UpdatePicker();
	}

	void UpdatePreview()
	{
		if ( View is not { IsValid: true } || !UiState.HasAccess )
			return;

		preview ??= new CarPreviewScene();

		// A hot reload rebuilds the panel tree, which gives this panel a new, empty ScenePanel while the scene above
		// survives in the field. Point the view at the scene again.
		if ( View.RenderScene != preview.Scene )
			View.RenderScene = preview.Scene;

		preview.Show( CarCatalog.Find( UiState.SelectedId ), ShownLook() );
		UpdateDrag();

		if ( !dragging && sinceTouched > IdleBeforeSpin )
			preview.Yaw += SpinSpeed * Time.Delta;

		preview.Update();
	}

	/// <summary>
	/// While the mouse is held on the 3D view, turn the car with it: across turns it, up and down tilts the view.
	/// </summary>
	void UpdateDrag()
	{
		var pressed = View.HasActive;
		var mouse = View.MousePosition * View.ScaleFromScreen;

		if ( pressed && !dragging )
		{
			dragging = true;
			lastMouse = mouse;
		}
		else if ( pressed )
		{
			var delta = mouse - lastMouse;
			lastMouse = mouse;

			preview.Yaw += delta.x * DragDegrees;
			preview.Elevation += delta.y * DragDegrees;
			sinceTouched = 0;
		}
		else
		{
			dragging = false;
		}
	}

	/// <summary>
	/// Zoom with the wheel while the mouse is over the 3D view. Anywhere else the wheel does what it did before.
	/// </summary>
	public override void OnMouseWheel( Vector2 value )
	{
		if ( preview is null || View is not { IsValid: true, HasHovered: true } || value.y == 0 )
		{
			base.OnMouseWheel( value );
			return;
		}

		// Scrolling down moves the camera away.
		preview.ZoomBy( value.y );
		sinceTouched = 0;
	}

	public override void OnDeleted()
	{
		base.OnDeleted();

		preview?.Destroy();
		preview = null;
	}

	protected override void OnAction( string action, string[] args ) => ViewModel.Act( action, args );

	protected override int BuildHash() => UiState.Revision;
}
