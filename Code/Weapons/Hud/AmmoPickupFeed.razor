@using Sandbox.UI
@inherits PanelComponent
@namespace Sandbox

<root>
	@foreach ( var notice in Notices )
	{
		<div @key=@notice class="pickup">
			<label class="amount">+@notice.Amount</label>
			<label class="name">@notice.Type.Title</label>
			@if ( notice.Type.Icon is not null )
			{
				<Image class="icon" Texture=@notice.Type.Icon/>
			}
		</div>
	}
</root>

@code
{
	/// <summary>
	/// The local player's recent pickups that have not expired. Nothing is drawn while a Navi app or a menu has the screen.
	/// </summary>
	IEnumerable<WeaponInventory.AmmoPickupNotice> Notices
	{
		get
		{
			if ( NaviInputCapture.Current is not null || AbilityMenu.IsOpen || CharacterMenu.IsOpen )
				return [];

			var inventory = Scene.GetAllComponents<WeaponInventory>().FirstOrDefault( x => !x.IsProxy );
			return inventory.IsValid() ? inventory.AmmoPickupNotices.Where( x => x.ExpiresAt > RealTime.Now ) : [];
		}
	}

	protected override int BuildHash()
	{
		var hash = new HashCode();

		foreach ( var notice in Notices )
		{
			hash.Add( notice );
			hash.Add( notice.Amount );
		}

		return hash.ToHashCode();
	}
}
