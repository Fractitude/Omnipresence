@using Sandbox.UI
@inherits PanelComponent
@namespace Sandbox

<root>
	@* Hidden while a Navi app has the player's input: the view is on the screen then, not aimed at the world. *@
	@if ( NaviInputCapture.Current is null )
	{
		<div class="dot"></div>
	}
</root>

@code
{
	/// <summary>
	/// Hide and lock the OS cursor. World panels are then hovered by the camera's
	/// forward ray (see <see cref="WorldInput"/>), which is where this dot sits.
	/// Not while a Navi app has the player's input: the cursor is free on the screen then.
	/// </summary>
	[Property] public bool HideCursor { get; set; } = true;

	protected override void OnUpdate()
	{
		if ( HideCursor && NaviInputCapture.Current is null )
		{
			Mouse.Visibility = MouseVisibility.Hidden;
		}
	}

	protected override int BuildHash() => System.HashCode.Combine( NaviInputCapture.Current );

	protected override void OnDisabled()
	{
		Mouse.Visibility = MouseVisibility.Auto;
	}
}
