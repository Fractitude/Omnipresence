@using Sandbox.UI
@inherits PanelComponent
@namespace Sandbox

<root class="menu-root @( IsOpen ? "open" : "" )" @onmouseup=@( ( PanelEvent e ) => EndDrag( e ) )>
	@if ( IsOpen && target.IsValid() && PlayerCrime.Local is { } crime && PlayerInventory.Local is { } bag )
	{
		var used = bag.SlotCount - bag.FreeSlots;

		<MenuWindow Title=@target.Title OnClose=@Close
		            Notice=@( crime.ToldCount > toldAtOpen ? crime.LastTold : null )
		            Hint="Drag to move. Shift: combine stacks. Ctrl: split half. Right click: more actions.">
			<ChildContent>
				<div class="body">
					<div class="column">
						<div class="heading-row">
							<div class="menu-heading">@( $"Your bag ({used}/{bag.SlotCount})" )</div>
							<div class="menu-button compact" @onclick=@( () => SortBag() )>Sort</div>
						</div>
						<div @ref="bagGridRef" class="grid" style="width: @( bag.Columns * (SlotSize + Gap) )px">
							@for ( var i = 0; i < bag.SlotCount; i++ )
							{
								var slot = i;
								var item = bag.At( slot );
								<div class="slot @( item is null ? "empty" : "" ) @( Marks( false, slot ) )"
								     @onmousedown=@( ( PanelEvent e ) => BeginDrag( false, slot, e ) )
								     @onrightclick=@( () => OpenMenu( false, slot ) )
								     @onmouseover=@( () => HoverBag( slot ) )
								     @onmouseout=@( () => HoverBag( -1, slot ) )>
									@if ( item is not null )
									{
										<ItemIcon PrefabPath=@item.PrefabPath ModelPath=@item.ModelPath
										          Icon=@ItemCatalog.IconFor( item )
										          Color=@ItemCatalog.ColorFor( item )/>
										@if ( item.IsBatch )
										{
											<div class="count">@( $"x{item.Count}" )</div>
										}
									}
								</div>
							}
						</div>
					</div>
					<div class="column">
						@if ( !target.ViewReady )
						{
							<div class="menu-heading">@target.Title</div>
							<div class="menu-empty">Opening...</div>
						}
						else
						{
							<div class="heading-row">
								<div class="menu-heading">@( $"{target.Title} ({target.ViewCount}/{target.Capacity})" )</div>
								<div class="menu-button compact" @onclick=@( () => SortBox() )>Sort</div>
							</div>
							<div @ref="boxGridRef" class="grid" style="width: @( target.ColumnCount * (SlotSize + Gap) )px">
								@for ( var i = 0; i < target.Capacity; i++ )
								{
									var slot = i;
									var item = target.ViewAt( slot );
									<div class="slot @( item is null ? "empty" : "" ) @( Marks( true, slot ) )"
									     @onmousedown=@( ( PanelEvent e ) => BeginDrag( true, slot, e ) )
									     @onrightclick=@( () => OpenMenu( true, slot ) )
									     @onmouseover=@( () => HoverBox( slot ) )
									     @onmouseout=@( () => HoverBox( -1, slot ) )>
										@if ( item is not null )
										{
											<ItemIcon PrefabPath=@item.PrefabPath ModelPath=@item.ModelPath
											          Icon=@ItemCatalog.IconFor( item )
											          Color=@ItemCatalog.ColorFor( item )/>
											@if ( item.IsBatch )
											{
												<div class="count">@( $"x{item.Count}" )</div>
											}
										}
									</div>
								}
							</div>
							@if ( target is VehicleCargo cargo )
							{
								<div class="menu-heading">
									@( $"Big objects ({cargo.ViewObjects.Count}/{cargo.MaxBigObjects})" )
								</div>
								@if ( cargo.ViewObjects.Count == 0 )
								{
									<div class="menu-empty">Nothing big aboard. Use "Load into vehicle" on an object nearby.</div>
								}
								@for ( var i = 0; i < cargo.ViewObjects.Count; i++ )
								{
									var index = i;
									var placeable = PlaceableCatalog.Find( cargo.ViewObjects[i].Placeable );
									<div class="menu-row roomy big-object">
										<div class="menu-icon">
											<ItemIcon Icon=@( placeable?.Icon ?? "deployed_code" ) Color="#d9a15b"/>
										</div>
										<div class="info">@( placeable?.Name ?? "Object" )</div>
										<div class="menu-button" @onclick=@( () => UnloadObject( cargo, index ) )>
											Unload
										</div>
									</div>
								}
							}
						}
					</div>
				</div>
			</ChildContent>
		</MenuWindow>

		@if ( Dragged is { } dragged )
		{
			var position = Mouse.Position * Panel.ScaleFromScreen;
			<div class="ghost" style="left: @( position.x )px; top: @( position.y )px">
				<ItemIcon PrefabPath=@dragged.PrefabPath ModelPath=@dragged.ModelPath
				          Icon=@ItemCatalog.IconFor( dragged ) Color=@ItemCatalog.ColorFor( dragged )/>
				@if ( DropLabel is { } label )
				{
					<div class="ghost-label">@label</div>
				}
			</div>
		}
		else if ( Hovered is { } hovered )
		{
			@* The full details of the item under the mouse, like the inventory shows. *@
			var position = Mouse.Position * Panel.ScaleFromScreen;
			<div class="details" style="left: @( position.x + 18 )px; top: @( position.y + 18 )px">
				<div class="name">@hovered.Name</div>
				@if ( hovered.IsBatch )
				{
					@foreach ( var line in ItemCatalog.DescribeLines( hovered ) )
					{
						<div class="description">@line</div>
					}
				}
				@if ( !string.IsNullOrEmpty( hovered.Description ) )
				{
					<div class="description">@hovered.Description</div>
				}
			</div>
		}
	}
</root>

@code
{
	const string MenuName = "storage";
	const int SlotSize = 56;
	const int Gap = 6;

	/// <summary>
	/// Seconds between asks for the box's contents while the panel is open (the host may have changed them).
	/// </summary>
	const float RefreshSeconds = 2f;

	/// <summary>
	/// Whether the panel is open on this computer.
	/// </summary>
	public static bool IsOpen { get; private set; }

	// Static: the panel's mouse events and this component's updates are not always on the same instance.
	static ItemContainer target;
	static int toldAtOpen;
	static int hoverBag = -1;
	static int hoverBox = -1;
	static RealTimeSince sinceRefresh;

	// The drag: where it started (the box, or the bag) and which slot, and the slot under the mouse while it lasts.
	static bool dragging;
	static bool dragFromBox;
	static int dragSlot = -1;
	static bool overBox;
	static int overSlot = -1;

	// The two grids, to find the slot under the mouse (the mouse buttons read false over a panel, so the drop is read
	// from the panel's mouseup and the slot from where the mouse is).
	static Panel bagGridRef;
	static Panel boxGridRef;

	/// <summary>
	/// The item being dragged, or null.
	/// </summary>
	static ItemData Dragged => !dragging ? null
		: dragFromBox ? (target.IsValid() ? target.ViewAt( dragSlot ) : null)
		: PlayerInventory.Local?.At( dragSlot );

	/// <summary>
	/// The item in a slot of the bag or the box as this player sees it, or null.
	/// </summary>
	static ItemData ItemAt( bool inBox, int slot ) =>
		inBox ? (target.IsValid() ? target.ViewAt( slot ) : null) : PlayerInventory.Local?.At( slot );

	/// <summary>
	/// Whether the mouse is on a slot other than the one being dragged.
	/// </summary>
	static bool OverOther => dragging && overSlot >= 0 && !(overBox == dragFromBox && overSlot == dragSlot);

	/// <summary>
	/// The label beside the dragged icon while Shift or Ctrl is held ("Combine", "Split half", ...), or null.
	/// </summary>
	static string DropLabel
	{
		get
		{
			var mode = StackDrag.Held();

			if ( Dragged is not { } dragged || mode == StackMode.None )
				return null;

			return StackDrag.Label( dragged, OverOther ? ItemAt( overBox, overSlot ) : null, mode, OverOther );
		}
	}

	/// <summary>
	/// The item under the mouse while nothing is dragged, or null.
	/// </summary>
	static ItemData Hovered
	{
		get
		{
			if ( dragging )
				return null;

			if ( hoverBag >= 0 )
				return PlayerInventory.Local?.At( hoverBag );

			return hoverBox >= 0 && target.IsValid() ? target.ViewAt( hoverBox ) : null;
		}
	}

	/// <summary>
	/// Open the panel, from a storage box or a cargo the player used. Does nothing with another menu open.
	/// </summary>
	public static void Open( ItemContainer box )
	{
		if ( IsOpen || !box.IsValid() || PlayerCrime.Local is not { } crime || GameMenus.IsAnyOpen
		     || NaviInputCapture.Current is not null )
			return;

		target = box;
		toldAtOpen = crime.ToldCount;
		hoverBag = hoverBox = -1;
		CancelDrag();
		box.ClearView();
		IsOpen = true;
		GameMenus.SetOpen( "storage", true );

		// The host answers with the contents, and claims an unclaimed box for this player.
		box.RequestRefresh();
		sinceRefresh = 0;
	}

	static void Close()
	{
		if ( !IsOpen )
			return;

		IsOpen = false;
		GameMenus.SetOpen( "storage", false );
		ContextMenu.HideFor( MenuName );

		if ( target.IsValid() )
			target.ClearView();

		target = null;
		hoverBag = hoverBox = -1;
		CancelDrag();
		bagGridRef = boxGridRef = null;
		MenuControls.Free( true );
		Mouse.Visibility = MouseVisibility.Hidden;
	}

	/// <summary>
	/// The host said the box is not this player's: close the panel (the host told them why).
	/// </summary>
	public static void Refused( ItemContainer box )
	{
		if ( IsOpen && target == box )
			Close();
	}

	/// <summary>
	/// Ask the host to move the bag's item in a slot into the box. Only the slot goes; the host checks everything.
	/// </summary>
	static void Store( int slot )
	{
		CancelDrag();

		if ( target.IsValid() && PlayerInventory.Local?.At( slot ) is not null )
			target.RequestStore( slot );
	}

	/// <summary>
	/// Ask the host to tidy the bag half of the window: the same kinds together, from the first slot. The host checks
	/// who asks and how far they are, as it does for any other move here.
	/// </summary>
	static void SortBag()
	{
		CancelDrag();

		if ( target.IsValid() )
			target.RequestSortBag();
	}

	/// <summary>
	/// Ask the host to tidy the box (or the cargo) beside the bag.
	/// </summary>
	static void SortBox()
	{
		CancelDrag();

		if ( target.IsValid() )
			target.RequestSort();
	}

	/// <summary>
	/// Ask the host to put a big object of the vehicle's cargo on the ground behind it. Only the place in the list goes.
	/// </summary>
	static void UnloadObject( VehicleCargo cargo, int index )
	{
		CancelDrag();

		if ( cargo.IsValid() )
			cargo.RequestUnloadObject( index );
	}

	/// <summary>
	/// Ask the host to move the box's item in a slot into the bag.
	/// </summary>
	static void Take( int slot )
	{
		CancelDrag();

		if ( target.IsValid() && target.ViewAt( slot ) is not null )
			target.RequestTake( slot );
	}

	/// <summary>
	/// Right click on a slot: a small menu of what can be done with the stack there. What it lists is
	/// <see cref="ItemMenus"/>; each entry asks the host for the same thing a drag or a key does, with slot numbers only.
	/// </summary>
	static void OpenMenu( bool inBox, int slot )
	{
		CancelDrag();

		if ( !target.IsValid() || ItemAt( inBox, slot ) is not { } item )
		{
			ContextMenu.HideFor( MenuName );
			return;
		}

		var cargo = target as VehicleCargo;

		var verbs = inBox
			? ItemMenus.ForContainer( item, cargo.IsValid() )
			: ItemMenus.ForBag( item, target.ActionWord );

		ContextMenu.Show( MenuName, item.Name, ItemMenus.Bind( verbs, verb => verb switch
		{
			ItemMenus.ToContainer => () => Store( slot ),
			ItemMenus.ToBag => () => Take( slot ),
			ItemMenus.Drop => () => PlayerInventory.Local?.Drop( slot ),
			ItemMenus.Unload => () =>
			{
				if ( cargo.IsValid() && cargo.ViewAt( slot ) is not null )
					cargo.RequestUnloadItem( slot );
			},
			_ => null,
		} ) );
	}

	/// <summary>
	/// A button went down on a slot: if it holds an item, start dragging it. A right press is a right click and does not
	/// drag.
	/// </summary>
	static void BeginDrag( bool fromBox, int slot, PanelEvent e )
	{
		// The button's name on this event is not reliable (the untyped event can leave it empty), so only a button that
		// is known to be the right one is turned away: a right press is a right click, not a drag.
		var button = e?.Button ?? "";

		if ( !target.IsValid() || button.Contains( "right", System.StringComparison.OrdinalIgnoreCase )
		     || button.Contains( "2" ) )
			return;

		var item = fromBox ? target.ViewAt( slot ) : PlayerInventory.Local?.At( slot );

		if ( item is null )
			return;

		dragging = true;
		dragFromBox = fromBox;
		dragSlot = slot;
		overBox = fromBox;
		overSlot = slot;
	}

	static void CancelDrag()
	{
		dragging = false;
		dragSlot = overSlot = -1;
	}

	/// <summary>
	/// The mouse button came up: drop the dragged item on the slot under the mouse. Nothing under the mouse, or the
	/// slot it came from (a plain click), changes nothing. Only slot numbers go to the host, which checks everything.
	/// </summary>
	static void EndDrag( PanelEvent e )
	{
		if ( !dragging )
			return;

		var fromBox = dragFromBox;
		var from = dragSlot;
		CancelDrag();

		if ( !target.IsValid() || !SlotAt( Mouse.Position, out var toBox, out var to )
		     || (fromBox == toBox && from == to) )
			return;

		// With Shift or Ctrl held a drop combines or splits, or does nothing: it never swaps.
		var mode = StackDrag.Held( e );

		if ( mode != StackMode.None )
		{
			if ( StackDrag.Worth( ItemAt( toBox, to ), mode ) )
				target.RequestStack( fromBox ? StorageRules.SideBox : StorageRules.SideBag, from,
					toBox ? StorageRules.SideBox : StorageRules.SideBag, to, (int)mode );

			return;
		}

		if ( fromBox && toBox )
			target.RequestMoveInBox( from, to );
		else if ( fromBox )
			target.RequestTakeTo( from, to );
		else if ( toBox )
			target.RequestStoreTo( from, to );
		else
			target.RequestMoveInBag( from, to );
	}

	/// <summary>
	/// The slot under a screen position, in the box or in the bag, or false.
	/// </summary>
	static bool SlotAt( Vector2 position, out bool inBox, out int slot )
	{
		inBox = false;
		slot = -1;

		foreach ( var (grid, box) in new[] { (bagGridRef, false), (boxGridRef, true) } )
		{
			if ( grid is not { IsValid: true } )
				continue;

			var index = 0;

			foreach ( var child in grid.Children )
			{
				if ( child.Box.Rect.IsInside( position ) )
				{
					inBox = box;
					slot = index;
					return true;
				}

				index++;
			}
		}

		return false;
	}

	/// <summary>
	/// The style classes of a slot: the one being dragged, and the one a drop would go to.
	/// </summary>
	static string Marks( bool inBox, int slot )
	{
		if ( !dragging )
			return "";

		var marks = dragFromBox == inBox && dragSlot == slot ? "dragged " : "";

		if ( overBox != inBox || overSlot != slot || marks != "" )
			return marks;

		// A held key only marks a slot its drop would work on.
		var mode = StackDrag.Held();
		return mode == StackMode.None || StackDrag.Works( Dragged, ItemAt( inBox, slot ), mode ) ? "target" : "";
	}

	static void HoverBag( int slot, int leaving = -1 )
	{
		if ( slot >= 0 || hoverBag == leaving )
			hoverBag = slot;
	}

	static void HoverBox( int slot, int leaving = -1 )
	{
		if ( slot >= 0 || hoverBox == leaving )
			hoverBox = slot;
	}

	protected override void OnUpdate()
	{
		if ( !IsOpen )
			return;

		var controller = Players.LocalController;

		// Escape closes the right-click menu first, the drag next, and the panel after that.
		if ( ContextMenu.IsOpen && Input.EscapePressed )
		{
			Input.EscapePressed = false;
			ContextMenu.Hide();
			return;
		}

		// Escape drops a drag in the air first, and closes the panel the next time.
		if ( dragging && Input.EscapePressed )
		{
			Input.EscapePressed = false;
			CancelDrag();
			return;
		}

		// Leave if the player walked away or died, the box is gone, another menu took over, or Escape was pressed.
		if ( Input.EscapePressed || NaviInputCapture.Current is not null || PlayerCrime.Local is null
		     || controller is null || !target.IsValid() || !target.IsNear( controller.WorldPosition ) )
		{
			Input.EscapePressed = false;
			Close();
			return;
		}

		Mouse.Visibility = MouseVisibility.Visible;
		MenuControls.Free( false );

		// The slot a drop would go to.
		if ( dragging )
		{
			if ( SlotAt( Mouse.Position, out var inBox, out var slot ) )
			{
				overBox = inBox;
				overSlot = slot;
			}
			else
			{
				overSlot = -1;
			}
		}

		if ( sinceRefresh > RefreshSeconds )
		{
			sinceRefresh = 0;
			target.RequestRefresh();
		}
	}

	protected override void OnDisabled() => Close();

	protected override int BuildHash()
	{
		// The dragged icon and the details follow the mouse.
		var following = dragging || hoverBag >= 0 || hoverBox >= 0;

		return System.HashCode.Combine(
			IsOpen, target.IsValid() ? target.ViewVersion : 0, PlayerInventory.Local?.Version,
			PlayerCrime.Local?.ToldCount, System.HashCode.Combine( hoverBag, hoverBox, dragging, dragSlot, overSlot ),
			overBox, dragging ? StackDrag.Held() : StackMode.None,
			following ? Mouse.Position : default );
	}
}
