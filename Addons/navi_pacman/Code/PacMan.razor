@using Sandbox.UI
@inherits Panel
@namespace NaviPacMan

@* A Navi Store app: a plain panel that uses no Navi types, described by pacman.napp in Assets/. *@
@* While the player sits at the computer, Navi gives this window their keys when it's in front, *@
@* and marks the panel with the "navi-input" class while it has them. It is also Shared: in multiplayer the host's *@
@* copy runs the game with the keys of whoever uses the computer, and every client draws the frames it publishes. *@
@* The window can be resized, and the .napp's AspectRatio has the desktop keep it the shape of the frame below. The *@
@* frame is drawn at its own size and scaled to fill the window, centered if the window is another shape. *@

<root>
	<div class="frame" @ref="Frame">
		<div class="hud">
			<div class="score">@UiState.Score</div>
			<div class="level">LEVEL @UiState.Level</div>
			<div class="lives">
				@for ( var i = 0; i < UiState.Lives - 1; i++ )
				{
					<div class="life"></div>
				}
			</div>
			<div class="auto @( UiState.Auto ? "on" : "" )"
			     @onclick=@(() => Navi.Act( this, PacManViewModel.AutoAction ))>AUTO</div>
		</div>

		<div class="stage">
			<PacManBoard @ref="Board"></PacManBoard>

			@if ( Message is { } message )
			{
				<div class="message">@message</div>
			}
		</div>
	</div>
</root>

@code
{
	Panel Frame;
	PacManBoard Board;
	float frameScale;

	/// <summary>
	/// The game, in the host's copy only.
	/// </summary>
	PacManViewModel ViewModel => field ??= new(this);

	/// <summary>
	/// What is drawn: the game's latest frame, or on a viewer the latest one the host's copy published.
	/// </summary>
	PacManUiState UiState => Navi.IsViewer( this ) ? Navi.GetState<PacManUiState>( this ) ?? PacManUiState.Empty : ViewModel.UiState;

	string Message => UiState switch
	{
		{ Paused: true } => "PAUSED",
		{ State: PacManGameState.Ready } => "READY!",
		{ State: PacManGameState.GameOver } => "GAME OVER - PRESS A KEY",
		_ => null,
	};

	public override void Tick()
	{
		base.Tick();

		var viewer = Navi.IsViewer( this );

		// The game runs only while this window has the player's input.
		if ( !viewer )
		{
			ViewModel.Tick( Navi.HasInput( this ) && IsVisible );
			Navi.Publish( this, ViewModel.UiState );
		}

		Board?.Draw( UiState, smooth: viewer );
		ScaleFrame();
	}

	/// <summary>
	/// Scale the frame to the biggest size that fits the window. Layout boxes ignore transforms, so the frame keeps its
	/// own size to measure, and the root centers it.
	/// </summary>
	void ScaleFrame()
	{
		if ( Frame is null || Frame.Box.Rect.Width <= 0f || Frame.Box.Rect.Height <= 0f )
			return;

		var scale = System.MathF.Min( Box.Rect.Width / Frame.Box.Rect.Width, Box.Rect.Height / Frame.Box.Rect.Height );
		if ( !float.IsFinite( scale ) || scale <= 0f || System.MathF.Abs( scale - frameScale ) < 0.001f )
			return;

		frameScale = scale;
		var transform = new PanelTransform();
		transform.AddScale( scale );
		Frame.Style.Transform = transform;
	}

	protected override void OnEvent( PanelEvent e )
	{
		// The Auto button, from whoever uses the computer: only the host's copy has a game to hand to the autopilot.
		if ( Navi.IsAction( e, out var action, out var args ) )
		{
			if ( !Navi.IsViewer( this ) )
				ViewModel.Act( action, args );

			e.StopPropagation();
			return;
		}

		base.OnEvent( e );
	}

	// Not the revision, which goes up every frame: the board draws those without a rebuild.
	protected override int BuildHash() => System.HashCode.Combine( UiState.Score, UiState.Lives, UiState.Level, Message, UiState.Auto );
}
