@using Sandbox.UI
@inherits Panel
@namespace NaviPacMan

@* A Navi Store app: a plain panel that uses no Navi types, described by pacman.napp in Assets/. *@
@* pacman.napp sets CapturesInput, so Navi gives this window the player's keys while it's in front, *@
@* and marks the panel with the "navi-input" class while it has them. It is also Shared: in multiplayer the host's *@
@* copy runs the game with the keys of whoever uses the computer, and every client draws the frames it publishes. *@

<root>
	<div class="hud">
		<div class="score">@UiState.Score</div>
		<div class="level">LEVEL @UiState.Level</div>
		<div class="lives">
			@for ( var i = 0; i < UiState.Lives - 1; i++ )
			{
				<div class="life"></div>
			}
		</div>
	</div>

	<div class="stage">
		<PacManBoard @ref="Board"></PacManBoard>

		@if ( Message is { } message )
		{
			<div class="message">@message</div>
		}
	</div>
</root>

@code
{
	PacManBoard Board;

	/// <summary>
	/// The game, in the host's copy only.
	/// </summary>
	PacManViewModel ViewModel => field ??= new(this);

	/// <summary>
	/// What is drawn: the game's latest frame, or on a viewer the latest one the host's copy published.
	/// </summary>
	PacManUiState UiState => Navi.IsViewer( this ) ? Navi.GetState<PacManUiState>( this ) ?? PacManUiState.Empty : ViewModel.UiState;

	string Message => UiState switch
	{
		{ Paused: true } => "PAUSED",
		{ State: PacManGameState.Ready } => "READY!",
		{ State: PacManGameState.GameOver } => "GAME OVER - PRESS A KEY",
		_ => null,
	};

	public override void Tick()
	{
		base.Tick();

		var viewer = Navi.IsViewer( this );

		// The game runs only while this window has the player's input.
		if ( !viewer )
		{
			ViewModel.Tick( Navi.HasInput( this ) && IsVisible );
			Navi.Publish( this, ViewModel.UiState );
		}

		Board?.Draw( UiState, smooth: viewer );
	}

	// Not the revision, which goes up every frame: the board draws those without a rebuild.
	protected override int BuildHash() => System.HashCode.Combine( UiState.Score, UiState.Lives, UiState.Level, Message );
}
